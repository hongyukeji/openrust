use openrust::{
    database::eloquent::Model,
    http::{
        Request, StatusCode,
        resources::json::{JsonResource, ResourceResult},
    },
};
use serde_json::Value;

pub struct {{class}}<M>(pub M);

impl<M: Model> From<M> for {{class}}<M> {
    fn from(model: M) -> Self {
        Self(model)
    }
}

#[allow(non_snake_case, reason = "保留既定公开接口及命名")]
impl<M: Model> JsonResource for {{class}}<M> {
    fn to_array(&self, _request: &Request) -> ResourceResult<Value> {
        Ok(Value::Object(self.0.to_array()?))
    }

    fn status(&self) -> StatusCode {
        if self.0.state().wasRecentlyCreated() {
            StatusCode::CREATED
        } else {
            StatusCode::OK
        }
    }
}
