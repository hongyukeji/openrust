use std::{sync::Arc, time::SystemTime};

use openrust::{
    contracts::queue::JobHandler,
    queue::{DispatchOptions, DispatchResult, JobContext, JobOptions, Payload, QueueError, QueueFuture, QueueResult},
    queue::middleware::{JobMiddleware, SkipIfBatchCancelled},
    support::facades::Queue,
};

#[derive(serde::Deserialize, serde::Serialize)]
pub struct {{class}};

impl {{class}} {
    pub const NAME: &'static str = concat!(module_path!(), "::", stringify!({{class}}));

    pub async fn dispatch(&self) -> QueueResult<DispatchResult> {
        Queue::dispatch(self.payload()?, DispatchOptions::default(), None).await
    }

    pub fn payload(&self) -> QueueResult<Payload> {
        let payload = Payload::new(Self::NAME, self)?;
        let options = JobOptions {
            retry_until: self.retryUntil(None)?,
            ..JobOptions::default()
        };
        Ok(payload.with_options(options))
    }

    pub fn register() -> QueueResult<()> {
        Queue::register(Self::NAME, Arc::new({{class}}Handler))
    }

    pub async fn handle(
        &self,
        _context: &mut JobContext<'_>,
        _batch_id: Option<&str>,
    ) -> QueueResult<()> {
        Ok(())
    }

    #[allow(non_snake_case, reason = "Matches Laravel's job retryUntil method")]
    pub fn retryUntil(&self, previous: Option<SystemTime>) -> QueueResult<Option<SystemTime>> {
        Ok(previous)
    }

    pub async fn failed(&self, _context: &mut JobContext<'_>, _error: &QueueError) -> QueueResult<()> {
        Ok(())
    }
}

struct {{class}}Handler;

impl JobHandler for {{class}}Handler {
    fn middleware(&self) -> Vec<Arc<dyn JobMiddleware>> {
        vec![Arc::new(SkipIfBatchCancelled)]
    }

    fn handle<'a>(
        &'a self,
        context: &'a mut JobContext<'_>,
        payload: &'a Payload,
    ) -> QueueFuture<'a, QueueResult<()>> {
        Box::pin(async move {
            let job: {{class}} =
                serde::Deserialize::deserialize(payload.data()).map_err(|_| QueueError::InvalidPayload)?;
            job.handle(context, payload.batchId()).await
        })
    }

    #[allow(non_snake_case, reason = "Matches Laravel's job retryUntil method")]
    fn retryUntil(&self, payload: &Payload) -> QueueResult<Option<SystemTime>> {
        let job: {{class}} =
            serde::Deserialize::deserialize(payload.data()).map_err(|_| QueueError::InvalidPayload)?;
        job.retryUntil(payload.options().retry_until)
    }

    fn failed<'a>(
        &'a self,
        context: &'a mut JobContext<'_>,
        payload: &'a Payload,
        error: &'a QueueError,
    ) -> QueueFuture<'a, QueueResult<()>> {
        Box::pin(async move {
            let job: {{class}} =
                serde::Deserialize::deserialize(payload.data()).map_err(|_| QueueError::InvalidPayload)?;
            job.failed(context, error).await
        })
    }
}
