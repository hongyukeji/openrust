use openrust::routing::RoutingError;

pub(crate) fn register() -> Result<(), RoutingError> {
    #[cfg(feature = "sanctum")]
    openrust::support::facades::Route::getWith("/user", user, |route| {
        route.middleware_name("auth:sanctum");
        Ok(())
    })?;
    Ok(())
}

#[cfg(feature = "sanctum")]
fn user(
    request: &mut openrust::http::Request,
) -> openrust::http::HttpFuture<'_, Result<openrust::http::Response, openrust::http::HttpError>> {
    use openrust::{
        http::{HttpError, Response, StatusCode},
        support::facades::Auth,
    };

    Box::pin(async move {
        let auth = Auth::manager()?;
        let user = auth
            .user(request)
            .await?
            .ok_or(HttpError::Unauthenticated)?;
        let attributes = auth.userAttributes(user.as_ref())?;
        Response::json(StatusCode::OK, attributes)
    })
}
