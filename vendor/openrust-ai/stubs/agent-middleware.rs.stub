use openrust::http::HttpFuture;
use openrust_ai::{
    AgentMiddleware, AiResult, NextStep, NextStreamStep, PendingStep, StepResponse, StepResult,
};

pub struct {{class}};

impl AgentMiddleware for {{class}} {
    fn handle<'a, 'step: 'a>(
        &'a self,
        step: PendingStep<'step>,
        next: NextStep<'a, 'step>,
    ) -> HttpFuture<'a, AiResult<StepResponse>> {
        next.run(step)
    }

    fn handle_stream<'a, 'step: 'a>(
        &'a self,
        step: PendingStep<'step>,
        next: NextStreamStep<'a, 'step>,
    ) -> HttpFuture<'a, AiResult<StepResult>> {
        next.run(step)
    }
}
