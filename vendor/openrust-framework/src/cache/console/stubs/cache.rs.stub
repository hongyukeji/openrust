use openrust::database::{
    DatabaseFuture, DatabaseResult,
    migrations::{Migration, MigrationContext},
};

pub struct Definition;

impl Migration for Definition {
    fn up<'a>(
        &'a self,
        connection: &'a mut MigrationContext,
    ) -> DatabaseFuture<'a, DatabaseResult<()>> {
        Box::pin(async move {
            let mut schema = connection.get_schema_builder();
            schema
                .create("cache", |table| {
                    table.string("key", None).primary();
                    table.medium_text("value");
                    table.big_integer("expiration").index();
                })
                .await?;
            schema
                .create("cache_locks", |table| {
                    table.string("key", None).primary();
                    table.string("owner", None);
                    table.big_integer("expiration").index();
                })
                .await
        })
    }

    fn down<'a>(
        &'a self,
        connection: &'a mut MigrationContext,
    ) -> DatabaseFuture<'a, DatabaseResult<()>> {
        Box::pin(async move {
            let mut schema = connection.get_schema_builder();
            schema.drop_if_exists("cache").await?;
            schema.drop_if_exists("cache_locks").await
        })
    }
}
