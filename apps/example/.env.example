# 复制为 .env 供本地开发使用。不要提交填入实际值的 .env 文件。
# 生产环境从进程环境变量读取配置，不读取此文件。
APP_ENV=development

# 可选：覆盖 config/*.toml 中的配置项。
# APP_SERVER__PORT=3000
# APP_SERVER__HOST=127.0.0.1
# APP_SERVER__PUBLIC_DIR=public
# APP_SERVER__ROOT_TARGET=file:/index.html
# APP_API__HTTP_STATUS=always_ok
# REDIS_URL=redis://127.0.0.1:6379/

DATABASE_URL=postgres://openrust:openrust@localhost:5432/example

# 使用 openrust key generate 生成独立密钥。
APP_AUTH__JWT__KEYS__LOCAL=
APP_SECURITY__SIGNED_LINKS__KEYS__LOCAL=

# 使用 `openrust key generate` 生成密钥，并将其保存在密钥存储中。
APP_SECURITY__ENCRYPTION__ACTIVE_KEY_ID=local
APP_SECURITY__ENCRYPTION__KEYS__LOCAL=

# 可选：SMTP 邮件投递配置。
# APP_MAIL__DRIVER=smtp
# APP_MAIL__SMTP_HOST=mail.example.com
# APP_MAIL__SMTP_PORT=587
# APP_MAIL__SMTP_STARTTLS=true
# 本地 Mailpit 地址为 127.0.0.1:1025 时，将 SMTP_STARTTLS 设为 false。
# APP_MAIL__SMTP_USERNAME=
# APP_MAIL__SMTP_PASSWORD=
# 可选：Twilio 短信驱动（sms-twilio feature）。
# APP_SMS__DRIVER=twilio
# APP_SMS__ACCOUNT_SID=
# APP_SMS__API_KEY_SID=
# APP_SMS__API_KEY_SECRET=
# APP_SMS__FROM 和 APP_SMS__MESSAGING_SERVICE_SID 必须且只能设置一项。
