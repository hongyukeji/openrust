# 复制为 .env 供本地或部署环境使用。不要提交填入实际值的 .env 文件。
# 生产环境可使用权限受控的 .env 或部署平台注入的变量；进程环境变量优先。
APP_ENV=development

# 应用名称与地址。
APP_NAME=example
APP_URL=http://localhost:3000

# 服务
# APP_SERVER_PORT=3000
# APP_SERVER_HOST=127.0.0.1
# APP_SERVER_PUBLIC_DIR=public
# APP_SERVER_ROOT_TARGET=file:/index.html
# APP_API_HTTP_STATUS=always_ok

# 本地开发
# 仅本地开发需要时取消注释；生产环境保持默认值。
# APP_SESSION_SECURE=false
# APP_VIEW_AUTO_RELOAD=true

# 缓存
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_DEFAULT_STORE=default

# 数据库
# 以下连接值仅为本地开发示例，部署时请按实际环境修改。
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=example
DB_USERNAME=openrust
DB_PASSWORD=openrust
# MySQL 应用使用 DB_CONNECTION=mysql 和 DB_PORT=3306。
DB_TABLE_PREFIX=tb_

# 队列默认使用数据库；需要 Redis 队列时改用以下配置。
QUEUE_DRIVER=database
# Redis 队列与缓存共用以上 REDIS_* 连接配置。
# QUEUE_DRIVER=redis

# 日志、邮件、短信与国际化
APP_LOG_LEVEL=info
MAIL_DRIVER=log
SMS_DRIVER=log
I18N_DEFAULT_LOCALE=en

# 使用 openrust key generate 生成独立密钥。
APP_AUTH_JWT_KEYS_LOCAL=
APP_SECURITY_SIGNED_LINKS_KEYS_LOCAL=

# 使用 `openrust key generate` 生成密钥，并将其保存在密钥存储中。
APP_SECURITY_ENCRYPTION_ACTIVE_KEY_ID=local
APP_SECURITY_ENCRYPTION_KEYS_LOCAL=

# 可选：SMTP 邮件投递配置。
# MAIL_DRIVER=smtp
# MAIL_SMTP_HOST=mail.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_STARTTLS=true
# 本地 Mailpit 地址为 127.0.0.1:1025 时，将 SMTP_STARTTLS 设为 false。
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# 可选：Twilio 短信驱动（sms-twilio feature）。
# SMS_DRIVER=twilio
# SMS_ACCOUNT_SID=
# SMS_API_KEY_SID=
# SMS_API_KEY_SECRET=
# SMS_FROM 和 SMS_MESSAGING_SERVICE_SID 必须且只能设置一项。
