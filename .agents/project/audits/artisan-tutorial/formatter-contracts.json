  "native_adaptations": [
    {
      "contract": "Retained mutable style references",
      "reason": "FormatterStyle is Arc<dyn OutputFormatterStyleInterface>; default style synchronizes its mutable configuration. Concrete Clone copies state, Arc clone and cloned stacks retain original object references. User iterator/string conversions run before locks.",
      "evidence": "console_formatter_styles"
    },
    {
      "contract": "Implicit object cloning",
      "reason": "Reuse locked dyn-clone1.0.20 as a direct framework dependency. Implementers use ordinary Clone; no new resolved package or parallel clone utility.",
      "evidence": "Cargo.lock; Cargo.toml; public custom trait object consumer"
    },
    {
      "contract": "Append hook",
      "reason": "Default append_to writes into the same output buffer to avoid a temporary String; custom implementations default to apply and must preserve equivalent output.",
      "evidence": "formatter_style.rs; formatter-style-oracle.json"
    },
    {
      "contract": "Errors and numeric compatibility",
      "reason": "Result preserves concrete error sources; new From<ConsoleFormatError> permits command ?. Malformed six-digit hex values follow fixed numeric coercion without emitting PHP VM deprecation messages; original stderr retained.",
      "evidence": "formatter-style-tests2.log; formatter-style-tests4.log; formatter-style-*.stderr"
    }
  ],
  "research": [
    {
      "url": "https://docs.rs/dyn-clone/1.0.20/dyn_clone/",
      "used": "Object-safe cloning without custom clone scaffolding"
    },
    {
      "url": "https://raw.githubusercontent.com/symfony/console/v7.4.0/Tests/Formatter/OutputFormatterStyleTest.php",
      "used": "Constructor/color/options/href public consumers"
    },
