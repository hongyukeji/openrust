    },
    {
      "url": "https://docs.rs/parking_lot/0.12.5/parking_lot/type.ReentrantMutex.html",
      "used": "Same-thread reentry and serialization; existing lock version, no new resolved package"
    },
    {
      "url": "https://raw.githubusercontent.com/symfony/console/v7.4.0/Tests/Formatter/OutputFormatterTest.php",
      "used": "Public formatter parser and style/clone/escaping/wrapping cases"
    }
  ],
