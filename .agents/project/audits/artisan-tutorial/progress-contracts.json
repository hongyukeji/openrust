  "native_adaptations": [
    {
      "contract": "per-application named format/placeholder definitions",
      "reason": "Concurrent applications must not share mutable process-global definitions; capture owner on construction.",
      "evidence": "definitions_follow_the_owning_application_and_callbacks_can_reenter_the_registry"
    },
    {
      "contract": "memory placeholder",
      "reason": "Native process RSS from existing memory_stats; PHP VM heap statistics do not exist in Rust.",
      "evidence": "elapsed_estimates_memory_and_default_throttling_use_real_native_sources"
    },
    {
      "contract": "integer and UTF-8 error boundaries",
      "reason": "Result preserves concrete sources; invalid UTF-8 and unrepresentable native counts fail explicitly. PHP VM warnings are retained in source evidence, not emitted by Rust.",
      "evidence": "progress-operations-source2.json; progress-extreme-before-fix.log; progress-boundary-tests1.log"
    },
    {
      "contract": "Lazy iteration count and errors",
      "reason": "IntoIterator conversion is deferred to first next. Exact size_hint infers total; no exact hint leaves unknown or retains existing manual max. Errors are terminal Result items; early drop does not finish.",
      "evidence": "console_progress_iteration"
    },
    {
      "contract": "Awaited and mutable task callbacks",
      "reason": "Reuse ConsoleFuture and current execution scope; borrowed boxed futures await real I/O before advancing. Explicit mutable variants preserve models without Clone; numeric vs iterable names retain distinct return types. No implicit transaction or rollback.",
      "evidence": "console_progress_async; progress-async-mysql.log"
    },
    {
      "contract": "Placeholder output argument",
      "reason": "Borrow the selected stream sequentially through bar.get_output, without unsafe overlapping mutable references, runtime alias locks or cloned buffers. Both actual CLI stderr and captured output reuse the existing formatter and sink.",
      "evidence": "console_progress_output; progress-output-oracle.json; progress-output-cli-oracle.json"
    },
    {
      "contract": "Selected output configuration and command isolation",
      "reason": "Real CLI stderr has an independent verbosity override and decoration; primary setters update both. Captured single-stream output aliases its primary settings. Scoped command metadata restores both streams on cancellation and explicit nested flags apply temporarily. Already accepted bytes retain visibility through later level changes; raw direct buffer edits still follow command filtering.",
      "evidence": "console_output_configuration; output-configuration-before-filter-fix.log; output-configuration-before-reuse-fix.log"
    }
  ],
