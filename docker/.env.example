# 按需合并到项目根 .env；Compose 不加载 docker/.env。
# Docker 配置
# 镜像
# APP_IMAGE_NAME=openrust
# APP_IMAGE_VERSION=latest

# 构建
# APP_BUILD_FEATURES=
# APP_BUILD_JOBS=4

# 挂载路径，相对 docker/ 目录
# APP_STORAGE_PATH=./data/storage
# APP_PUBLIC_PATH=../public

# 容器连接
# PostgreSQL 使用 postgres:5432，MySQL 使用 mysql:3306。
# DOCKER_DB_HOST=postgres
# DOCKER_DB_PORT=5432
# DOCKER_REDIS_HOST=redis

# 配套服务宿主端口与 Nginx 入口
# POSTGRES_PORT=5432
# MYSQL_PORT=3306
# NGINX_HOST=0.0.0.0
# NGINX_PORT=8080
