# 复制为 .env，在仓库根目录本地运行集成宿主时使用。
# 实际 .env 已被 Git 忽略；生产环境可使用权限受控的 .env 或部署平台注入的进程环境变量。
APP_ENV=development
APP_NAME=openrust
APP_URL=http://localhost:3000

# 数据库：启用 db-postgres 或 db-mysql 后，按项填写连接信息。
# 以下连接值仅为本地开发示例，部署时请按实际环境修改。
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=openrust
DB_USERNAME=openrust
DB_PASSWORD=openrust
# MySQL 示例：DB_CONNECTION=mysql，DB_PORT=3306。
DB_TABLE_PREFIX=tb_

# 缓存：默认 store 使用 Redis。
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_DEFAULT_STORE=default

# 环境变量覆盖 config/ 下按领域划分的 TOML 配置。
# APP_SERVER_PORT=3000
# APP_LOG_LEVEL=info

# 其他驱动配置
MAIL_DRIVER=log
SMS_DRIVER=log
I18N_DEFAULT_LOCALE=en
# Redis 队列需启用 queue-redis feature 后再取消注释。
# QUEUE_DRIVER=redis
