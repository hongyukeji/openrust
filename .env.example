# 复制为 .env，在仓库根目录本地运行集成宿主时使用。
# 实际 .env 已被 Git 忽略；生产环境可使用权限受控的 .env 或部署平台注入的进程环境变量。
APP_ENV=development
APP_NAME=openrust
# 服务端错误详情开关；部署环境保持 false。
APP_DEBUG=false
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
SERVER_PORT=3000
APP_URL="http://localhost:${SERVER_PORT}"
# 用 key:generate 设置应用密钥。
APP_KEY=

# 标准构建已包含 MySQL；按部署环境填写连接信息。
# 以下连接值仅为本地开发示例，部署时请按实际环境修改。
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=openrust
DB_USERNAME=openrust
DB_PASSWORD=openrust
# PostgreSQL：启用 db-postgres，设置 DB_CONNECTION=postgres、DB_PORT=5432。
DB_TABLE_PREFIX=

# 缓存：默认 store 使用 Redis。
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis

# 环境变量覆盖 config/*.rs 的应用默认值。
# APP_LOG_LEVEL=info
# LOG_DEPRECATIONS_CHANNEL=null
# LOG_DEPRECATIONS_TRACE=false
# LOG_DEPRECATIONS_WHILE_TESTING=false

# 其他驱动配置
MAIL_DRIVER=log
SMS_DRIVER=log
# 标准构建已包含两种队列 driver；选择连接不会自动启动 worker。
QUEUE_CONNECTION=database
# 可选 Redis 队列：QUEUE_CONNECTION=redis。先执行迁移，再用 cargo run 启动应用及队列。
# QUEUE_REDIS_URL=redis://127.0.0.1:6379/0
# QUEUE_REDIS_NAMESPACE=server

# Argon 与 bcrypt 共用统一 HashManager。
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12
HASH_VERIFY=true
BCRYPT_LIMIT=null
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
