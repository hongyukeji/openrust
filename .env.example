APP_NAME=OpenRust

APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_HOST=127.0.0.1
APP_PORT=8000
APP_URL="http://${APP_HOST}:${APP_PORT}"

APP_TIMEZONE=Asia/Shanghai

APP_LOCALE=zh-Hans
APP_FALLBACK_LOCALE=zh-Hans
APP_FAKER_LOCALE=zh-Hans
# APP_SUPPORTED_LOCALES=en,zh-Hans,zh-Hant

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# APP_DISABLED_RUNNERS=queue,schedule,reverb,grpc

API_PREFIX=/api

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_PREFIX=

# PostgreSQL configuration
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=openrust
# DB_USERNAME=root
# DB_PASSWORD=root

# MySQL configuration
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=openrust
# DB_USERNAME=root
# DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
# FILESYSTEM_WEB_ROOT=public
# FILESYSTEM_LOCAL_ROOT=storage/app/private

QUEUE_CONNECTION=database
# QUEUE_WORKER_MEMORY_LIMIT=256
# QUEUE_WORKER_STOP_ON_LOST_CONNECTION=true
# QUEUE_WORKER_KILL_ON_TIMEOUT=true
# QUEUE_WORKER_TIMED_OUT_EXIT_CODE=1

CACHE_STORE=database
# CACHE_PREFIX=

# Redis configuration
# CACHE_STORE=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_USERNAME=null
# REDIS_PASSWORD=null

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

# SMS configuration
