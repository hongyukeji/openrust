--- bootstrap/app.rs ---
use openrust::support::ServiceProvider;
use openrust::prelude::*;
use openrust_modules::ModuleProviderBuilderExt as _;

mod providers;

/// 应用运行根锚点与独立的模块激活配置；默认从当前工作目录解析。
#[derive(Default, serde::Deserialize)]
#[serde(default)]
pub struct Configuration {
    pub database: openrust::config::DatabaseConfig,
    pub modules: openrust_modules::config::ModulesConfig,
    pub application_root: Option<std::path::PathBuf>,
}

pub struct Blog;

impl openrust::foundation::ApplicationDefinition for Blog {
    type Config = Configuration;

    fn config() -> openrust::config::ConfigManifest {
        crate::config::boot()
    }

    fn default_providers() -> openrust::support::DefaultProviders {
        openrust::support::DefaultProviders::auto().except([
            openrust::foundation::ProviderId::of::<openrust::translation::TranslationServiceProvider>(),
        ]).merge([Box::new(crate::app::providers::translation_sources::TranslationSourcesProvider) as Box<dyn ServiceProvider>])
    }

    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        providers::application_providers(config)
    }

    fn configure_providers(config: &Self::Config, builder: &mut openrust::foundation::ProviderBuilder) {
        builder.class_descriptors([crate::app::http::controllers::home::HomePresenter::descriptor()]);
        builder.module_manifest(crate::modules::manifest(
            config
                .application_root
                .as_deref()
                .unwrap_or(std::path::Path::new(".")),
            &config.modules,
        ));
    }
}

/// 在启动装配中指定 API 前缀与无状态组，再登记应用 Web 路由和全局 fallback。
pub(crate) fn routes(routes: Router, prefix: &str) -> Router {
    let routes = routes.group(
        RouteGroup::new().prefix(prefix).middleware_group("api"),
        crate::routes::api::register,
    );
    crate::routes::web::register(routes)
}

--- bootstrap/providers.rs ---
//! 应用 Provider 清单，对应 Laravel 的 `bootstrap/providers.php`。

use openrust::support::ServiceProvider;

pub(super) fn application_providers(
    _config: &super::Configuration,
) -> Vec<Box<dyn ServiceProvider>> {
    let mut providers: Vec<Box<dyn ServiceProvider>> = Vec::new();
    providers.push(Box::new(crate::app::providers::AppServiceProvider));
    providers.push(Box::new(openrust::database::MigrationServiceProvider::<
        openrust::database::FrameworkMigrator,
    >::new()));
    providers
}

--- app/http/controllers/home.rs ---
//! 默认应用控制器；可从 `routes/api.rs` 直接注册。

use openrust::container::ClassDescriptor;
use openrust::core::ApiResponse;
use openrust::foundation::ApplicationState;
use openrust::http::Inject;
use openrust::http::axum::extract::State;
use std::{collections::BTreeMap, sync::Arc};

pub(crate) struct HomePresenter;

impl HomePresenter {
    pub(crate) fn descriptor() -> ClassDescriptor {
        ClassDescriptor::concrete::<Self>(
            concat!(module_path!(), "::HomePresenter"),
            vec![],
            |_| Ok(Arc::new(Self)),
        )
    }

    fn response(&self, name: &str) -> ApiResponse<BTreeMap<&'static str, String>> {
        ApiResponse::success(BTreeMap::from([("name", name.to_owned())]))
    }
}

/// 返回应用名称。
pub(crate) async fn index(
    State(state): State<ApplicationState>,
    Inject(presenter): Inject<HomePresenter>,
) -> ApiResponse<BTreeMap<&'static str, String>> {
    presenter.response(&state.config().app.name)
}

--- modules/mod.rs ---
//! 运行模块清单与显式编译绑定；元数据发现不执行未编译源码。

use openrust_modules::ModuleManifest;

/// 默认只加载显式登记模块；其他激活器按配置发现 module.json 与文件状态。
pub fn manifest(
    root: &std::path::Path,
    config: &openrust_modules::config::ModulesConfig,
) -> ModuleManifest {
    if config.activator == "registered" {
        ModuleManifest::new().with_application_root(root)
    } else {
        ModuleManifest::discover_from_config(root, config)
    }
}

