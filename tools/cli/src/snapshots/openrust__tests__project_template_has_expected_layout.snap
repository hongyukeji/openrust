    </main>
  </body>
</html>

--- resources/views/index.html ---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>blog</title>
    <link rel="stylesheet" href="/assets/site.css">
  </head>
  <body>
    <main>
      <h1>blog</h1>
      <p>应用首页模板位于 <code>views/index.html</code>。静态资源放在 <code>public/</code>。</p>
      <p><a href="/api">查看 API</a></p>
    </main>
  </body>
</html>

--- config/app.toml ---
[app]
name = "blog"
url = "http://localhost:3000"

--- config/cache.toml ---

[cache]
default_store = "default"

[cache.stores.default]
driver = "redis"
namespace = "blog"
dsn = "redis://127.0.0.1:6379/"

[cache.singleflight]
max_in_flight_keys = 128
max_waiters_per_key = 64
loader_timeout_secs = 30

[cache.swr]
max_in_flight_refreshes = 64

--- config/server.toml ---

[server]
host = "127.0.0.1"
port = 3000
public_dir = "public"
root_target = "view:index.html"
request_timeout_secs = 30
max_concurrent_requests = 1024
shutdown_timeout_secs = 10
metrics_endpoint_enabled = false
trusted_proxy_ranges = []

[server.compression]
enabled = true

[server.cors]
enabled = false

--- config/i18n.toml ---

[i18n]
default_locale = "en"
fallback_locale = "en"

--- src/main.rs ---
//! 应用程序入口。

#[path = "../bootstrap/app.rs"]
mod bootstrap;
#[path = "../app/mod.rs"]
mod app;
#[path = "../routes/web.rs"]
mod routes;

fn main() -> std::process::ExitCode {
    openrust::run::<bootstrap::Blog>()
}

--- bootstrap/app.rs ---
use openrust::http::HttpPlugin;
use openrust::i18n::I18nPlugin;
use openrust::mail::MailerPlugin;
use openrust::prelude::*;
use openrust::sms::SmsPlugin;

use crate::routes;

pub struct Blog;

impl Application for Blog {
    type Config = NoConfig;

    fn build(app: &mut AppBuilder) {
        app.plugin(HttpPlugin)
            .plugin(openrust::view::ViewPlugin)
            .plugin(I18nPlugin::default())
            .plugin(openrust::cache::CachePlugin)
            .plugin(MailerPlugin)
            .plugin(SmsPlugin)
            .routes(routes::register);
        crate::app::register(app);
    }
}

--- routes/web.rs ---
use openrust::prelude::*;

pub fn register(routes: Routes) -> Routes {
    routes.get("/api", root)
}

async fn root() -> Json<std::collections::BTreeMap<&'static str, &'static str>> {
    Json(std::collections::BTreeMap::from([(
        "name",
        env!("CARGO_PKG_NAME"),
    )]))
}

--- AGENTS.md ---
# 应用开发指南

本项目基于 OpenRust，普通 `cargo run` 启动应用，`cargo test` 执行测试。

`src/main.rs` 只负责入口；`bootstrap/app.rs` 装配应用，`routes/web.rs` 注册 HTTP 路由。业务放在 `app/`，配置在 `config/`，迁移与种子在 `database/`，资源在 `resources/`，公开文件在 `public/`，运行数据在 `storage/`。

本地依赖通过应用自身 Cargo.toml 的 workspace 配置解析；保持框架源码目录可达。gRPC 的 proto/build.rs 是独立编译期流程，启用 feature 不自动监听端口。
