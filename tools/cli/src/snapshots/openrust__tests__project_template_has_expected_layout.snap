--- config/app.toml ---
[app]
name = "blog"
url = "http://localhost:3000"

--- config/cache.toml ---

[cache]
default_store = "default"

[cache.stores.default]
driver = "redis"
namespace = "blog"
dsn = "redis://127.0.0.1:6379/"

[cache.singleflight]
max_in_flight_keys = 128
max_waiters_per_key = 64
loader_timeout_secs = 30

[cache.swr]
max_in_flight_refreshes = 64

--- config/server.toml ---

[server]
host = "127.0.0.1"
port = 3000
public_dir = "public"
root_target = "view:index.html"
request_timeout_secs = 30
max_concurrent_requests = 1024
shutdown_timeout_secs = 10
metrics_endpoint_enabled = false
trusted_proxy_ranges = []

[server.compression]
enabled = true

[server.cors]
enabled = false

--- config/i18n.toml ---

[i18n]
default_locale = "en"
fallback_locale = "en"

--- src/main.rs ---
//! 应用程序入口。

#[path = "../bootstrap/app.rs"]
mod bootstrap;
#[path = "../modules/mod.rs"]
mod modules;
#[path = "../app/mod.rs"]
mod app;
#[path = "../routes/web.rs"]
mod routes;

fn main() -> std::process::ExitCode {
    openrust::run::<bootstrap::Blog>()
}

--- bootstrap/app.rs ---
use std::sync::Arc;
use openrust::core::{BootContext, BoxFuture, RegisterContext, ServiceProvider};
use openrust::prelude::*;

use crate::routes;

struct ReadinessProvider;
impl ServiceProvider for ReadinessProvider {
    fn register(&self, app: &mut RegisterContext<'_>) -> Result<()> {
        app.instance(Arc::new(openrust::core::Readiness::default()));
        Ok(())
    }
}

struct RoutesProvider;
impl ServiceProvider for RoutesProvider {
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, Result<()>> {
        Box::pin(async move { app.routes(routes::register)?; Ok(()) })
    }
}

/// 应用自己的运行时模块根；默认从当前工作目录解析。
#[derive(Default, serde::Deserialize)]
#[serde(default)]
pub struct Configuration {
    pub modules_root: Option<std::path::PathBuf>,
}

pub struct Blog;

impl Application for Blog {
    type Config = Configuration;

    fn providers(_config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers: Vec<Box<dyn ServiceProvider>> = vec![
            Box::new(openrust::http::HttpServiceProvider),
            Box::new(ReadinessProvider),
            Box::new(openrust::view::ViewServiceProvider),
            Box::new(openrust::i18n::I18nServiceProvider::default()),
            Box::new(openrust::cache::CacheServiceProvider::new()),
            Box::new(openrust::mail::MailerServiceProvider),
            Box::new(openrust::sms::SmsServiceProvider),
        ];
        providers.push(Box::new(RoutesProvider));
        providers
    }

    fn modules(config: &Self::Config) -> openrust::core::ModuleManifest {
        crate::modules::manifest(config.modules_root.as_deref().unwrap_or(std::path::Path::new(".")))
    }
}

--- modules/mod.rs ---
//! 已编译业务模块的应用清单；声明代码与本次启动启用分别维护。

use openrust::core::ModuleManifest;

/// 登记已编译模块；从运行工作目录读取 `modules_statuses.json`。
pub fn manifest(root: &std::path::Path) -> ModuleManifest {
    ModuleManifest::from_file(root.join("modules_statuses.json"))
}

--- modules_statuses.json ---
{}

--- routes/web.rs ---
use openrust::prelude::*;

pub fn register(routes: Routes) -> Routes {
    routes.get("/api", root)
}

async fn root() -> Json<std::collections::BTreeMap<&'static str, &'static str>> {
    Json(std::collections::BTreeMap::from([(
        "name",
        env!("CARGO_PKG_NAME"),
    )]))
}

--- AGENTS.md ---
# 应用开发指南

本项目基于 OpenRust，普通 `cargo run` 启动应用，`cargo test` 执行测试。

`src/main.rs` 只负责入口；`bootstrap/app.rs` 装配应用，`routes/web.rs` 注册 HTTP 路由。`app/` 保留通用应用装配，业务放在 `modules/<业务>/`，配置在 `config/`，迁移与种子在 `database/`，资源在 `resources/`，公开文件在 `public/`，运行数据在 `storage/`。

本地依赖通过应用自身 Cargo.toml 的 workspace 配置解析；保持框架源码目录可达。gRPC 的 proto/build.rs 是独立编译期流程，启用 feature 不自动监听端口。

`modules/mod.rs` 静态声明业务代码，并通过 `manifest(root)` 返回采用 `FileModuleActivator` 的公开 `ModuleManifest`；默认从运行工作目录读取 `modules_statuses.json`，与默认 `config/` 加载约定一致；部署时从应用根启动，不能把编译机路径当部署根。`bootstrap/app.rs` 的 `Application::modules` 使用此清单；模块的 `ModuleDescriptor` 引入普通 ServiceProvider，与框架共用唯一容器和 register/boot 生命周期。模块根使用部署时的应用目录；生成的 `Configuration.modules_root` 可显式指定运行根，`Application::modules` 把相同根传给状态文件和各模块 descriptor，不扫描 Rust 源码或在运行时自动加载 crate。启用状态文件默认是空对象 `{}`；只有对应名称的 JSON `true` 启用模块，缺少文件/键、`false` 或其他非 `true` 值均关闭，损坏 JSON 启动失败且不被自动覆写。状态变更只影响下次应用启动，不热卸载当前应用；管理写命令尚未实现。

模块专属配置、迁移、资源与测试留在该模块目录；现有根级生成器产物属于应用级职责，模块生成与资源发布等管理命令仍待后续实现。第三方依赖在本应用 Cargo.toml 管理，不在普通模块下放无效 Cargo.toml。
