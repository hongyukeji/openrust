--- Cargo.toml ---
[package]
name = "blog"
publish = false
version.workspace = true
edition.workspace = true
license.workspace = true

[dependencies]
openrust = { workspace = true, features = ["cache-redis", "view"] }

--- .gitignore ---
/target/
/storage/
.env
.env.*
!.env.example
!.env.*.example

--- public/index.html ---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>blog</title>
  </head>
