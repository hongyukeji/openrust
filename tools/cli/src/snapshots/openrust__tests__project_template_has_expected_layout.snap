--- tests/support/request_input.rs ---
//! 生成应用在公开 Provider 与 Request API 上的外部消费回归。
use figment::Figment;
use openrust::core::{Application, BootContext, BoxFuture, ServiceProvider};
use openrust::http::axum::{
    body::Body,
    http::{Method, Request, StatusCode, header::CONTENT_TYPE},
};
use openrust::http::{InputOutcome, Json, Request as InputRequest, Routes};
use openrust::support::{ArrayKey, BackedEnum, DateOptions, InputNumber, TimezoneInput};
use openrust::testing::TestApp;
use std::time::Duration;

#[derive(Debug, PartialEq, Eq)]
enum Approval {
    Accepted,
}

impl BackedEnum for Approval {
    type Backing = i64;

    fn try_from_backing(value: i64) -> Option<Self> {
        (value == 1).then_some(Self::Accepted)
    }
}

struct InputRoutesProvider;

impl ServiceProvider for InputRoutesProvider {
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            app.routes(|routes: Routes| routes.post("/test/request-input", inspect_input))?;
            Ok(())
        })
    }
}

// 保留生成应用的 Provider 与模块装配，只在本测试追加公开路由扩展。
struct InputApplication<A>(std::marker::PhantomData<fn() -> A>);

impl<A: Application> Application for InputApplication<A> {
    type Config = A::Config;

    fn config_namespace() -> &'static str {
        A::config_namespace()
    }

    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        providers.push(Box::new(InputRoutesProvider));
        providers
    }

    fn modules(config: &Self::Config) -> openrust::core::ModuleManifest {
        A::modules(config)
    }
}

async fn inspect_input(request: InputRequest) -> openrust::Result<Json<serde_json::Value>> {
    let items = request.collect("items")?;
    let profile = request.fluent("profile")?;
    let date = request
        .date_with(
            "date",
            DateOptions {
                format: Some("!Y-m-d H:i:s"),
                timezone: Some(TimezoneInput::Name("Asia/Shanghai")),
            },
        )?
        .ok_or_else(|| openrust::Error::custom("test_date_missing", "测试日期缺失"))?;
    let interval = request
        .interval("interval")?
        .ok_or_else(|| openrust::Error::custom("test_interval_missing", "测试区间缺失"))?;
    let approval = request.enum_value::<Approval>("approval")?;
    let has_false_continues = matches!(
        request.when_has("zero", |_| Ok(false))?,
        InputOutcome::Request(_)
    );
    let missing_default_is_false = matches!(
        request.when_missing_or_else("zero", |_| Ok(true), || Ok(false))?,
        InputOutcome::Default(false)
    );

    Ok(Json(serde_json::json!({
        "string": request.string("name")?.to_string(),
        "null_string_default": request.string_or("nil", "fallback")?.to_string(),
        "missing_string_default": request.string_or("missing", "fallback")?.to_string(),
        "null_integer_default": request.integer_or("nil", 7)?,
        "missing_integer_default": request.integer_or("missing", 7)?,
        "float": request.float("float")?,
        "missing_boolean_default": request.boolean_or("missing", true)?,
        "approval": approval == Some(Approval::Accepted),
        "unknown_approval_default": request.enum_or("unknown_approval", Approval::Accepted)? == Approval::Accepted,
        "item_string_key": items.get(ArrayKey::from("02")).cloned(),
        "item_integer_key": items.get(2_i64).cloned(),
        "profile_name": profile.get("person.name")?,
        "clamped": request.clamp("score", InputNumber::Integer(0), InputNumber::Integer(10))?,
        "has_false_continues": has_false_continues,
        "missing_default_is_false": missing_default_is_false,
        "date": date.format("Y-m-d H:i:s P")?,
        "interval": {
            "years": interval.years,
            "months": interval.months,
            "days": interval.days,
            "hours": interval.hours,
            "minutes": interval.minutes,
            "seconds": interval.seconds,
            "microseconds": interval.microseconds,
            "total_days": interval.total_days(),
        }
    })))
}

/// 通过生成应用自身的 Provider 清单发送进程内请求，不代表 TCP 验收。
pub async fn assert_request_input<A: Application>(
    source: Figment,
) -> Result<(), Box<dyn std::error::Error>> {
    let mut app = TestApp::<InputApplication<A>>::builder(source)
        .build()
        .await?;
    let result: Result<(), Box<dyn std::error::Error>> = async {
        let body = serde_json::json!({
            "name": "  Ada  ",
            "nil": null,
            "float": "2.5suffix",
            "approval": "1",
            "unknown_approval": 8,
            "items": {"02": "string", "2": "integer"},
            "profile": {"person": {"name": "Ada"}},
            "score": 14,
            "zero": 0,
            "date": "2024-03-10 12:30:40",
            "interval": "P1Y2M3DT4H5M6S"
        });
        let request = Request::builder()
            .method(Method::POST)
            .uri("/test/request-input")
            .header(CONTENT_TYPE, "application/json")
            .body(Body::from(serde_json::to_vec(&body)?))?;
        app.request(request)
            .await?
            .assert_status(StatusCode::OK)?
            .assert_json(&serde_json::json!({
                "success": true,
                "code": "ok",
                "message": "ok",
                "data": {
                "string": "Ada",
                "null_string_default": "",
                "missing_string_default": "fallback",
                "null_integer_default": 0,
                "missing_integer_default": 7,
                "float": 2.5,
                "missing_boolean_default": true,
                "approval": true,
                "unknown_approval_default": true,
                "item_string_key": "string",
                "item_integer_key": "integer",
                "profile_name": "Ada",
                "clamped": 10,
                "has_false_continues": true,
                "missing_default_is_false": true,
                "date": "2024-03-10 12:30:40 +08:00",
                "interval": {
                    "years": 1,
                    "months": 2,
                    "days": 3,
                    "hours": 4,
                    "minutes": 5,
                    "seconds": 6,
                    "microseconds": 0,
                    "total_days": null
                }
                }
            }))?;
        Ok(())
    }
    .await;
    let shutdown = app
        .shutdown(openrust::tokio::time::Instant::now() + Duration::from_secs(5))
        .await;
    result?;
    shutdown?;
    Ok(())
}

--- tests/support/request_cookie.rs ---
//! 生成应用经正式 Provider、请求读取与响应中间件验证 Cookie 契约。
use figment::Figment;
use openrust::config::SessionConfig;
use openrust::core::{Application, BootContext, BoxFuture, ServiceProvider};
use openrust::http::axum::{
    Extension,
    body::Body,
    http::{
        HeaderValue, Request, StatusCode,
        header::{COOKIE, SET_COOKIE},
    },
    response::IntoResponse,
};
use openrust::http::{
    Cookie, CookieJar, CookieOptions, CookieResponseExt, Json, RequestInfo, Routes, SameSite,
};
use openrust::session::Session;
use openrust::testing::{TestApp, TestResponse};
use serde_json::{Value, json};
use std::time::{Duration, SystemTime, UNIX_EPOCH};

const PREFIX: &str = "/__framework_contract/request-cookie";
const NAMES: [&str; 3] = ["contract_queued", "contract_direct", "contract_many"];
const VALUES: [&str; 3] = ["queued;plus+value", "direct;plus+value", "many;plus+value"];

struct CookieRoutesProvider;

impl ServiceProvider for CookieRoutesProvider {
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            app.routes(|routes: Routes| {
                routes
                    .get(&format!("{PREFIX}/set"), set_cookies)
                    .get(&format!("{PREFIX}/inspect"), inspect_cookies)
                    .get(&format!("{PREFIX}/forget"), forget_cookies)
            })?;
            Ok(())
        })
    }
}

// 透传生成应用的正式服务和模块，仅追加本测试独占的路由 Provider。
struct CookieApplication<A>(std::marker::PhantomData<fn() -> A>);

impl<A: Application> Application for CookieApplication<A> {
    type Config = A::Config;

    fn config_namespace() -> &'static str {
        A::config_namespace()
    }

    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        providers.push(Box::new(CookieRoutesProvider));
        providers
    }

    fn modules(config: &Self::Config) -> openrust::core::ModuleManifest {
        A::modules(config)
    }
}

fn options() -> CookieOptions {
    CookieOptions {
        path: Some(PREFIX.into()),
        secure: Some(false),
        same_site: Some(SameSite::Strict),
        ..CookieOptions::default()
    }
}

async fn set_cookies(
    jar: CookieJar,
    session: Option<Extension<Session>>,
) -> openrust::Result<impl IntoResponse> {
    let factory = jar.factory();
    jar.queue(factory.make(NAMES[0], VALUES[0], 5, options())?)?;
    let mut response = Json(json!({"queued": true, "direct": true, "many": true}))
        .with_cookie(factory.make(NAMES[1], VALUES[1], 5, options())?)?
        .with_cookies([factory.make(NAMES[2], VALUES[2], 5, options())?])?
        .into_response();
    if let Some(Extension(session)) = session {
        response.headers_mut().insert(
            "x-contract-session-name",
            HeaderValue::from_str(&session.name()?).map_err(openrust::Error::internal)?,
        );
    }
    Ok(response)
}

async fn inspect_cookies(info: RequestInfo) -> Json<Value> {
    // 仅比较固定测试叶；不把原始 Cookie 或原始请求头写入响应。
    Json(json!({
        "queued": info.cookie(NAMES[0]) == Some(json!(VALUES[0])),
        "direct": info.cookie(NAMES[1]) == Some(json!(VALUES[1])),
        "many": info.cookie(NAMES[2]) == Some(json!(VALUES[2])),
        "present": info.has_cookie(NAMES[0]),
        "missing_default": info.cookie_or("contract_missing", json!("fallback")) == json!("fallback")
    }))
}

async fn forget_cookies(jar: CookieJar) -> openrust::Result<impl IntoResponse> {
    jar.expire(NAMES[0], options())?;
    Json(json!({"forgotten": true}))
        .with_cookie(jar.factory().forget(NAMES[1], options())?)?
        .with_cookies([jar.factory().forget(NAMES[2], options())?])
}

/// 在生成应用自身的正式 Provider 和中间件链路验证 Cookie；不替代真实 TCP 验收。
pub async fn assert_request_cookie<A: Application>(
    source: Figment,
    expect_session: bool,
) -> openrust::Result<()> {
    let mut app = TestApp::<CookieApplication<A>>::builder(source)
        .build()
        .await?;
    let outcome: openrust::Result<()> = async {
        let response = app.request(request("set", None)?).await?;
        check_response(
            &response,
            json!({"queued": true, "direct": true, "many": true}),
        )?;
        let session_name = session_name(&response, expect_session)?;
        let session_config = if expect_session {
            Some(
                app.app()?
                    .section::<SessionConfig>("session")
                    .map_err(openrust::Error::internal)?,
            )
        } else {
            None
        };
        let mut pairs = check_cookie_headers(
            &response,
            false,
            session_name.as_deref().zip(session_config.as_ref()),
        )?;
        let cookie_header = pairs.join("; ");

        let response = app
            .request(request("inspect", Some(&cookie_header))?)
            .await?;
        check_response(&response, inspection(true))?;
        if let Some(pair) = check_session_only(
            &response,
            session_name.as_deref().zip(session_config.as_ref()),
        )? {
            *pairs.get_mut(NAMES.len()).ok_or_else(mismatch)? = pair;
        }
        let cookie_header = pairs.join("; ");

        // 不携带上次 Cookie 的请求既无读取值，也不能收到上次请求的队列。
        let response = app.request(request("inspect", None)?).await?;
        check_response(&response, inspection(false))?;
        check_session_only(
            &response,
            session_name.as_deref().zip(session_config.as_ref()),
        )?;

        let response = app
            .request(request("forget", Some(&cookie_header))?)
            .await?;
        check_response(&response, json!({"forgotten": true}))?;
        check_cookie_headers(
            &response,
            true,
            session_name.as_deref().zip(session_config.as_ref()),
        )?;

        let response = app.request(request("inspect", None)?).await?;
        check_response(&response, inspection(false))?;
        check_session_only(
            &response,
            session_name.as_deref().zip(session_config.as_ref()),
        )?;
        Ok(())
    }
    .await;
    // 业务检查仅返回 Result，保证失败也进入应用关闭流程。
    let shutdown = app
        .shutdown(openrust::tokio::time::Instant::now() + Duration::from_secs(5))
        .await;
    outcome?;
    shutdown?;
    Ok(())
}

fn inspection(present: bool) -> Value {
    json!({"queued": present, "direct": present, "many": present, "present": present, "missing_default": true})
}

fn request(action: &str, cookies: Option<&str>) -> openrust::Result<Request<Body>> {
    let mut builder = Request::builder().uri(format!("{PREFIX}/{action}"));
    if let Some(cookies) = cookies {
        builder = builder.header(COOKIE, cookies);
    }
    builder
        .body(Body::empty())
        .map_err(openrust::Error::internal)
}

fn check_response(response: &TestResponse, data: Value) -> openrust::Result<()> {
    response
        .assert_status(StatusCode::OK)?
        .assert_json(&json!({
            "success": true, "code": "ok", "message": "ok", "data": data
        }))?;
    Ok(())
}

fn session_name(response: &TestResponse, expected: bool) -> openrust::Result<Option<String>> {
    let mut values = response.headers().get_all("x-contract-session-name").iter();
    let name = values
        .next()
        .map(|value| value.to_str().map(str::to_owned))
        .transpose()
        .map_err(|_| mismatch())?;
    ensure(values.next().is_none() && name.is_some() == expected)?;
    Ok(name)
}

fn check_cookie_headers(
    response: &TestResponse,
    deletion: bool,
    session: Option<(&str, &SessionConfig)>,
) -> openrust::Result<Vec<String>> {
    let mut pairs = Vec::new();
    let now = i64::try_from(
        SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .map_err(|_| mismatch())?
            .as_secs(),
    )
    .map_err(|_| mismatch())?;
    for name in NAMES {
        let mut matching = response
            .headers()
            .get_all(SET_COOKIE)
            .iter()
            .filter_map(|header| {
                let header = header.to_str().ok()?;
                let pair = header.split(';').next()?;
                (pair.split_once('=').map(|(key, _)| key) == Some(name)).then_some((header, pair))
            });
        let (header, pair) = matching.next().ok_or_else(mismatch)?;
        ensure(matching.next().is_none())?;
        let model = Cookie::from_header(header)?;
        ensure(model.name() == name && model.path() == PREFIX)?;
        ensure(model.http_only() && model.secure() == Some(false))?;
        ensure(model.same_site() == Some(SameSite::Strict))?;
        let expires = model.expires().ok_or_else(mismatch)?.unix_timestamp();
        let max_age = header
            .split(';')
            .skip(1)
            .find_map(|attribute| {
                let (key, value) = attribute.trim().split_once('=')?;
                key.eq_ignore_ascii_case("max-age").then_some(value)
            })
            .ok_or_else(mismatch)?
            .parse::<i64>()
            .map_err(|_| mismatch())?;
        if deletion {
            ensure(expires < now && max_age == 0)?;
        } else {
            ensure(expires > now && max_age > 0 && max_age <= 300)?;
        }
        // 第一段逐字保留，既不解密 or1，也不假设当前应用采用明文保护模式。
        pairs.push(pair.to_owned());
    }
    let mut total = 0;
    let mut session_count = 0;
    for value in response.headers().get_all(SET_COOKIE) {
        total += 1;
        let header = value.to_str().map_err(|_| mismatch())?;
        let pair = header.split(';').next().ok_or_else(mismatch)?;
        let (name, value) = pair.split_once('=').ok_or_else(mismatch)?;
        if NAMES.contains(&name) {
            continue;
        }
        let (expected_name, config) = session.ok_or_else(mismatch)?;
        ensure(name == expected_name && !value.is_empty())?;
        check_session_cookie(header, expected_name, config)?;
        pairs.push(pair.to_owned());
        session_count += 1;
    }
    ensure(session_count == usize::from(session.is_some()))?;
    ensure(total == NAMES.len() + session_count)?;
    Ok(pairs)
}

fn check_session_only(
    response: &TestResponse,
    session: Option<(&str, &SessionConfig)>,
) -> openrust::Result<Option<String>> {
    let mut count = 0;
    let mut pair = None;
    for header in response.headers().get_all(SET_COOKIE) {
        let header = header.to_str().map_err(|_| mismatch())?;
        let first = header.split(';').next().ok_or_else(mismatch)?;
        let (name, value) = first.split_once('=').ok_or_else(mismatch)?;
        let (expected_name, config) = session.ok_or_else(mismatch)?;
        ensure(name == expected_name && !value.is_empty())?;
        check_session_cookie(header, expected_name, config)?;
        pair = Some(first.to_owned());
        count += 1;
    }
    ensure(count == usize::from(session.is_some()))?;
    Ok(pair)
}

fn check_session_cookie(header: &str, name: &str, config: &SessionConfig) -> openrust::Result<()> {
    let model = Cookie::from_header(header)?;
    ensure(model.name() == name && model.path() == config.path)?;
    if let Some(explicit) = config.cookie.as_deref() {
        ensure(name == explicit)?;
    }
    let domain = config
        .domain
        .as_deref()
        .filter(|value| !value.is_empty() && *value != "0");
    ensure(model.domain() == domain)?;
    // TestApp 发送普通本机 HTTP；未设置 Secure 时可信传输默认值为 false。
    ensure(model.secure() == Some(config.secure.unwrap_or(false)))?;
    ensure(model.http_only() == config.http_only)?;
    let same_site = match config
        .same_site
        .as_deref()
        .map(str::to_ascii_lowercase)
        .as_deref()
    {
        None => None,
        Some("lax") => Some(SameSite::Lax),
        Some("strict") => Some(SameSite::Strict),
        Some("none") => Some(SameSite::None),
        _ => return Err(mismatch()),
    };
    ensure(model.same_site() == same_site)?;
    let attributes = header.to_ascii_lowercase();
    ensure(
        attributes
            .split(';')
            .any(|part| part.trim() == "partitioned")
            == config.partitioned,
    )?;
    let max_age = header.split(';').skip(1).find_map(|attribute| {
        let (key, value) = attribute.trim().split_once('=')?;
        key.eq_ignore_ascii_case("max-age").then_some(value)
    });
    if config.expire_on_close {
        ensure(model.expires().is_none() && max_age.is_none())?;
    } else {
        let age = max_age
            .ok_or_else(mismatch)?
            .parse::<i64>()
            .map_err(|_| mismatch())?;
        let lifetime = i64::try_from(config.lifetime).map_err(|_| mismatch())?;
        ensure(model.expires().is_some() && age > 0 && age <= lifetime.saturating_mul(60))?;
    }
    Ok(())
}

fn ensure(condition: bool) -> openrust::Result<()> {
    if condition { Ok(()) } else { Err(mismatch()) }
}

fn mismatch() -> openrust::Error {
    openrust::Error::custom(
        "test_cookie_contract_mismatch",
        "生成应用 Cookie 契约不匹配",
    )
}

--- tests/support/request_session.rs ---
//! 生成应用经正式 Session Provider 与请求作用域验证跨请求生命周期。
use figment::Figment;
use openrust::config::SessionConfig;
use openrust::core::{Application, BootContext, BoxFuture, RegisterContext, ServiceProvider};
use openrust::http::axum::{
    body::Body,
    http::{
        Request, StatusCode,
        header::{COOKIE, SET_COOKIE},
    },
};
use openrust::http::{CookieJar, CookieOptions, Json, RequestInfo, Routes};
use openrust::session::{
    CookieSessionStore, DatabaseSessionStore, MemorySessionStore, Session, SessionId,
    SessionRecord, SessionRequestContext, SessionServiceProvider, SessionStore, SessionStoreHandle,
    SessionWriteMode, SessionWriteOutcome,
};
use openrust::testing::{TestApp, TestResponse};
use serde_json::{Value, json};
use std::sync::Arc;
use std::time::Duration;
use time::OffsetDateTime;

const PREFIX: &str = "/__framework_contract/request-session";
const NOTICE: &str = "contract.request_session.notice";
const NOW: &str = "contract.request_session.now";
const NULL: &str = "contract.request_session.null";
const SHARED: &str = "contract.request_session.shared";
const PREFERENCE: &str = "contract.request_session.preference";
const MEMO: &str = "contract.request_session.memo";
const LIST: &str = "contract.request_session.list";
const COUNT: &str = "contract.request_session.count";
const BODY_LIMIT: usize = 4096;
const REQUEST_TIMEOUT: Duration = Duration::from_secs(5);

struct SessionRoutes;
impl ServiceProvider for SessionRoutes {
    fn register(&self, app: &mut RegisterContext<'_>) -> openrust::Result<()> {
        // fixture 已明确选择 plain array 或 auth database；不是装饰任意已有 factory。
        app.singleton::<SessionStoreHandle, _>(|resolver| {
            Box::pin(async move {
                let config = resolver.section::<SessionConfig>("session")?;
                let backend: Arc<dyn SessionStore> = match config.driver.as_deref() {
                    Some("array") => Arc::new(MemorySessionStore::default()),
                    Some("cookie") => Arc::new(CookieSessionStore::new(
                        config.lifetime,
                        config.expire_on_close,
                    )?),
                    Some("database") => Arc::new(DatabaseSessionStore::new(
                        (*resolver.resolve::<openrust::db::Db>().await?).clone(),
                    )),
                    _ => return Err(mismatch()),
                };
                Ok(Arc::new(SessionStoreHandle::new(ContractRequestDriver {
                    backend,
                    context: None,
                })))
            })
        });
        Ok(())
    }
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            app.routes(|routes: Routes| {
                routes
                    .get(&format!("{PREFIX}/set"), set)
                    .get(&format!("{PREFIX}/inspect"), inspect)
                    .get(&format!("{PREFIX}/advance"), advance)
                    .get(&format!("{PREFIX}/remove"), remove)
                    .get(&format!("{PREFIX}/seed-one"), seed_one)
                    .get(&format!("{PREFIX}/seed-two"), seed_two)
                    .get(&format!("{PREFIX}/probe"), probe)
            })?;
            Ok(())
        })
    }
}

struct SessionApplication<A, const EXISTING: bool>(std::marker::PhantomData<fn() -> A>);
impl<A: Application, const EXISTING: bool> Application for SessionApplication<A, EXISTING> {
    type Config = A::Config;
    fn config_namespace() -> &'static str {
        A::config_namespace()
    }
    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        if !EXISTING
            && !providers.iter().any(|provider| {
                provider.id() == openrust::core::ProviderId::of::<SessionServiceProvider>()
            })
        {
            // plain 没有正式 Session 时才显式安装内存 driver；Cookie Provider 完整保留。
            providers.push(Box::new(
                SessionServiceProvider::with_store(MemorySessionStore::default())
                    .with_cookie_config(SessionConfig {
                        driver: Some("array".into()),
                        cookie: Some("contract_session".into()),
                        secure: Some(false),
                        ..SessionConfig::default()
                    }),
            ));
        }
        providers.push(Box::new(SessionRoutes));
        providers
    }
    fn modules(config: &Self::Config) -> openrust::core::ModuleManifest {
        A::modules(config)
    }
}

async fn set(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    let before = session.id()?;
    session.set_id(Some(before.as_str()))?;
    let actual = session.handler()?;
    ensure(Arc::ptr_eq(&actual, &session.set_handler(actual.clone())?))?;
    ensure(session.handler_needs_request()?)?;
    session.set_id(None)?;
    ensure(session.id()? != before)?;
    session
        .put(PREFERENCE, "preserved")?
        .put(NULL, Value::Null)?
        .flash(NOTICE, "next")?
        .now(NOW, "current")?;
    info.session()?.put(SHARED, "same request")?;
    session.put(MEMO, Value::Null)?;
    session.remember(MEMO, || Ok("computed"))?;
    session.push(LIST, "first")?;
    session.increment(COUNT)?;
    Ok(Json(snapshot(&session, &info)?))
}
async fn inspect(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    Ok(Json(snapshot(&session, &info)?))
}
async fn advance(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    session.remember(MEMO, || Ok("unexpected"))?;
    session.push(LIST, "second")?;
    session.increment_by(COUNT, 2)?;
    session.decrement(COUNT)?;
    session.decrement_by(COUNT, 2)?;
    Ok(Json(snapshot(&session, &info)?))
}
async fn remove(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    let removed = session.remove(MEMO)?;
    let mut data = snapshot(&session, &info)?;
    data["removed"] = json!(removed);
    Ok(Json(data))
}
fn snapshot(session: &Session, info: &RequestInfo) -> openrust::Result<Value> {
    Ok(json!({
        "cookie_name": session.name()?,
        "same_handle": info.has_session() && info.session()?.id()? == session.id()?,
        "shared_value": session.get(SHARED)? == Some(json!("same request")),
        "stored_null": session.get_or(NULL, json!("fallback"))? == Value::Null,
        "preference": session.get(PREFERENCE)?,
        "notice": session.get(NOTICE)?,
        "now": session.get(NOW)?,
        "memo": session.get(MEMO)?,
        "list": session.get(LIST)?,
        "count": session.get(COUNT)?,
    }))
}

/// 在正式生成应用内验证 Session；不是网络或存储 driver 的替代验收。
///
/// `existing_session=true` 保留认证 Provider 并显式选择同 Db 委托驱动；false 仅为没有
/// Session 的 plain 应用追加显式内存 driver。此参数不表示 Cookie 是否加密，
/// 响应不返回 ID/token，ID 仅在处理器内比较句柄；Set-Cookie 首段只逐字传入
/// 后续请求，不解密也不打印。
pub async fn assert_request_session<A: Application>(
    source: Figment,
    existing_session: bool,
) -> openrust::Result<()> {
    let cookie_source = source.clone();
    if existing_session {
        verify::<A, true>(source).await?;
    } else {
        verify::<A, false>(source).await?;
    }
    // 独立应用显式选择 Cookie driver；不改变原宿主/Auth 的数据库配置或 driver。
    verify::<CookieSessionApplication<A>, true>(cookie_source).await
}

struct CookieSessionApplication<A>(std::marker::PhantomData<fn() -> A>);
impl<A: Application> Application for CookieSessionApplication<A> {
    type Config = A::Config;
    fn config_namespace() -> &'static str {
        A::config_namespace()
    }
    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        let cookie: Box<dyn ServiceProvider> = Box::new(
            SessionServiceProvider::new().with_cookie_config(SessionConfig {
                driver: Some("cookie".into()),
                cookie: Some("contract_cookie_session".into()),
                secure: Some(false),
                ..Default::default()
            }),
        );
        // 替换原位置，保留 Auth 等 Provider 对 Session 先注册的依赖顺序。
        if let Some(index) = providers.iter().position(|provider| {
            provider.id() == openrust::core::ProviderId::of::<SessionServiceProvider>()
        }) {
            providers[index] = cookie;
        } else {
            providers.push(cookie);
        }
        providers
    }
    fn modules(config: &Self::Config) -> openrust::core::ModuleManifest {
        A::modules(config)
    }
}

#[allow(clippy::too_many_lines)] // 生成应用的正式 Provider、Cookie 往返和关闭必须留在同一生命周期。
async fn verify<A: Application, const EXISTING: bool>(source: Figment) -> openrust::Result<()> {
    let mut app = TestApp::<SessionApplication<A, EXISTING>>::builder(source)
        .build()
        .await?;
    let outcome: openrust::Result<()> = async {
        let first = app
            .request_with_limits(request("set", None)?, BODY_LIMIT, REQUEST_TIMEOUT)
            .await?;
        let name = first.json::<Value>()?["data"]["cookie_name"]
            .as_str()
            .ok_or_else(mismatch)?
            .to_owned();
        ensure(!name.is_empty() && name.len() <= 64 * 1024)?;
        check_response(
            &first,
            expected(
                &name,
                true,
                Some("next"),
                Some("current"),
                Some("computed"),
                Some(&["first"]),
                Some(1),
                None,
            ),
        )?;
        let first_cookie = cookie_pair(&first, &name)?;
        let second = app
            .request_with_limits(
                request("inspect", Some(&first_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &second,
            expected(
                &name,
                true,
                Some("next"),
                None,
                Some("computed"),
                Some(&["first"]),
                Some(1),
                None,
            ),
        )?;
        // 每次都从真实响应取得下一次 Cookie，不假定保护后的字节保持不变。
        let second_cookie = cookie_pair(&second, &name)?;
        let third = app
            .request_with_limits(
                request("inspect", Some(&second_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &third,
            expected(
                &name,
                true,
                None,
                None,
                Some("computed"),
                Some(&["first"]),
                Some(1),
                None,
            ),
        )?;
        let third_cookie = cookie_pair(&third, &name)?;
        let advanced = app
            .request_with_limits(
                request("advance", Some(&third_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &advanced,
            expected(
                &name,
                true,
                None,
                None,
                Some("computed"),
                Some(&["first", "second"]),
                Some(0),
                None,
            ),
        )?;
        let advanced_cookie = cookie_pair(&advanced, &name)?;
        let removed = app
            .request_with_limits(
                request("remove", Some(&advanced_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &removed,
            expected(
                &name,
                true,
                None,
                None,
                None,
                Some(&["first", "second"]),
                Some(0),
                Some("computed"),
            ),
        )?;
        let removed_cookie = cookie_pair(&removed, &name)?;
        let after_remove = app
            .request_with_limits(
                request("inspect", Some(&removed_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &after_remove,
            expected(
                &name,
                true,
                None,
                None,
                None,
                Some(&["first", "second"]),
                Some(0),
                None,
            ),
        )?;
        let isolated = app
            .request_with_limits(request("inspect", None)?, BODY_LIMIT, REQUEST_TIMEOUT)
            .await?;
        check_response(
            &isolated,
            expected(&name, false, None, None, None, None, None, None),
        )?;
        verify_request_driver(&app, &name).await?;
        Ok(())
    }
    .await;
    let shutdown = app
        .shutdown(openrust::tokio::time::Instant::now() + Duration::from_secs(5))
        .await;
    outcome?;
    shutdown?;
    Ok(())
}

#[allow(clippy::too_many_arguments)] // 逐项列出固定响应字段，避免测试遗漏原有 Session 与新增 Store 值。
fn expected(
    name: &str,
    persisted: bool,
    notice: Option<&str>,
    now: Option<&str>,
    memo: Option<&str>,
    list: Option<&[&str]>,
    count: Option<i64>,
    removed: Option<&str>,
) -> Value {
    let mut value = json!({"cookie_name":name, "same_handle":true, "shared_value":persisted,
        "stored_null":persisted, "preference":persisted.then_some("preserved"), "notice":notice, "now":now,
        "memo":memo,"list":list,"count":count});
    if let Some(removed) = removed {
        value["removed"] = json!(removed);
    }
    value
}
fn request(action: &str, cookies: Option<&str>) -> openrust::Result<Request<Body>> {
    let mut request = Request::get(format!("{PREFIX}/{action}")).header("host", "localhost");
    if let Some(cookies) = cookies {
        request = request.header(COOKIE, cookies);
    }
    request
        .body(Body::empty())
        .map_err(openrust::Error::internal)
}
fn check_response(response: &TestResponse, data: Value) -> openrust::Result<()> {
    response
        .assert_status(StatusCode::OK)?
        .assert_json(&json!({"success":true,"code":"ok","message":"ok","data":data}))?;
    Ok(())
}
fn cookie_pair(response: &TestResponse, name: &str) -> openrust::Result<String> {
    let mut selected = None;
    let mut data = Vec::new();
    for value in response.headers().get_all(SET_COOKIE) {
        let text = value.to_str().map_err(|_| mismatch())?;
        let pair = text.split(';').next().ok_or_else(mismatch)?;
        let (key, value) = pair.split_once('=').ok_or_else(mismatch)?;
        if key == name {
            ensure(selected.is_none() && !value.is_empty())?;
            selected = Some(pair.to_owned());
        } else if SessionId::parse(key).is_ok() && !value.is_empty() {
            data.push(pair.to_owned());
        }
    }
    let mut pairs = vec![selected.ok_or_else(mismatch)?];
    pairs.extend(data);
    Ok(pairs.join("; "))
}

fn ensure(condition: bool) -> openrust::Result<()> {
    if condition { Ok(()) } else { Err(mismatch()) }
}
fn mismatch() -> openrust::Error {
    openrust::Error::custom(
        "test_session_contract_mismatch",
        "生成应用 Session 契约不匹配",
    )
}

const PROBE: &str = "contract_session_probe";
const REPLY: &str = "contract_session_reply";
struct ContractRequestDriver {
    backend: Arc<dyn SessionStore>,
    context: Option<SessionRequestContext>,
}
impl SessionStore for ContractRequestDriver {
    fn supports_session_authentication(&self, cookie_name: &str) -> bool {
        self.backend.supports_session_authentication(cookie_name)
    }
    fn guarantees(&self) -> openrust::session::SessionStoreGuarantees {
        self.backend.guarantees()
    }
    fn needs_request(&self) -> bool {
        true
    }
    fn bind_request(
        &self,
        context: SessionRequestContext,
    ) -> openrust::Result<Option<Arc<dyn SessionStore>>> {
        let backend = if self.backend.needs_request() {
            self.backend
                .bind_request(context.clone())?
                .ok_or_else(mismatch)?
        } else {
            self.backend.clone()
        };
        Ok(Some(Arc::new(Self {
            backend,
            context: Some(context),
        })))
    }
    fn load<'a>(
        &'a self,
        id: &'a SessionId,
        max: usize,
        expiry: OffsetDateTime,
    ) -> BoxFuture<'a, openrust::Result<Option<SessionRecord>>> {
        Box::pin(async move {
            let value = self.backend.load(id, max, expiry).await?;
            self.acknowledge()?;
            Ok(value)
        })
    }
    fn write<'a>(
        &'a self,
        record: &'a SessionRecord,
        mode: SessionWriteMode,
        max: usize,
    ) -> BoxFuture<'a, openrust::Result<SessionWriteOutcome>> {
        Box::pin(async move {
            let value = self.backend.write(record, mode, max).await?;
            self.acknowledge()?;
            Ok(value)
        })
    }
    fn delete<'a>(&'a self, id: &'a SessionId) -> BoxFuture<'a, openrust::Result<()>> {
        self.backend.delete(id)
    }
}
impl ContractRequestDriver {
    fn acknowledge(&self) -> openrust::Result<()> {
        let Some(context) = &self.context else {
            return Ok(());
        };
        let value = match context.cookie(PROBE) {
            Some(Value::String(value)) if matches!(value.as_str(), "one" | "two") => value,
            _ => return Ok(()),
        };
        let jar = context.cookie_jar();
        jar.queue(
            jar.factory()
                .make(REPLY, value, 0, CookieOptions::default())?,
        )
    }
}
async fn seed_one(session: Session, jar: CookieJar) -> openrust::Result<Json<Value>> {
    seed(&session, &jar, "one")
}
async fn seed_two(session: Session, jar: CookieJar) -> openrust::Result<Json<Value>> {
    seed(&session, &jar, "two")
}
fn seed(session: &Session, jar: &CookieJar, value: &str) -> openrust::Result<Json<Value>> {
    ensure(session.handler_needs_request()?)?;
    jar.queue(
        jar.factory()
            .make(PROBE, value, 0, CookieOptions::default())?,
    )?;
    Ok(Json(json!({"seeded":true})))
}
async fn probe(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    Ok(Json(
        json!({"needs_request":session.handler_needs_request()?, "reply":info.cookie(REPLY)}),
    ))
}
async fn verify_request_driver<A: Application, const EXISTING: bool>(
    app: &TestApp<SessionApplication<A, EXISTING>>,
    name: &str,
) -> openrust::Result<()> {
    let mut first = Vec::<(String, String)>::new();
    let mut second = Vec::<(String, String)>::new();
    for (cookies, action) in [(&mut first, "seed-one"), (&mut second, "seed-two")] {
        let response = app
            .request_with_limits(request(action, None)?, BODY_LIMIT, REQUEST_TIMEOUT)
            .await?;
        check_response(&response, json!({"seeded":true}))?;
        merge_probe_cookies(&response, name, cookies)?;
    }
    for round in 0..2 {
        for (cookies, value) in [(&mut first, "one"), (&mut second, "two")] {
            let incoming = cookies
                .iter()
                .map(|(_, pair)| pair.as_str())
                .collect::<Vec<_>>()
                .join("; ");
            let response = app
                .request_with_limits(
                    request("probe", Some(&incoming))?,
                    BODY_LIMIT,
                    REQUEST_TIMEOUT,
                )
                .await?;
            check_response(
                &response,
                json!({"needs_request":true,"reply":(round == 1).then_some(value)}),
            )?;
            merge_probe_cookies(&response, name, cookies)?;
        }
    }
    Ok(())
}
fn merge_probe_cookies(
    response: &TestResponse,
    name: &str,
    cookies: &mut Vec<(String, String)>,
) -> openrust::Result<()> {
    for header in response.headers().get_all(SET_COOKIE) {
        let pair = header
            .to_str()
            .map_err(|_| mismatch())?
            .split(';')
            .next()
            .ok_or_else(mismatch)?;
        let (key, _) = pair.split_once('=').ok_or_else(mismatch)?;
        if ![name, PROBE, REPLY].contains(&key) && SessionId::parse(key).is_err() {
            continue;
        }
        if let Some(existing) = cookies.iter_mut().find(|(name, _)| name == key) {
            existing.1 = pair.to_owned();
        } else {
            cookies.push((key.to_owned(), pair.to_owned()));
        }
    }
    Ok(())
}

// 只追加路由，不注册或覆盖 Session，防止 fixture 掩盖生成宿主漏装 Provider。
struct OriginalHostRoutes;
impl ServiceProvider for OriginalHostRoutes {
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            app.routes(|routes| {
                routes
                    .get("/__original-session/write", original_write)
                    .get("/__original-session/read", original_read)
            })?;
            Ok(())
        })
    }
}
async fn original_write(session: Session) -> openrust::Result<Json<Value>> {
    session.put("contract.original_host", "persisted")?;
    original_read(session).await
}
async fn original_read(session: Session) -> openrust::Result<Json<Value>> {
    Ok(Json(
        json!({"value":session.get("contract.original_host")?,"snapshot":session.handler()?.guarantees()==openrust::session::SessionStoreGuarantees::ClientSideSnapshot}),
    ))
}
struct OriginalHost<A>(std::marker::PhantomData<fn() -> A>);
impl<A: Application> Application for OriginalHost<A> {
    type Config = A::Config;
    fn config_namespace() -> &'static str {
        A::config_namespace()
    }
    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        assert_eq!(
            providers
                .iter()
                .filter(|provider| provider.id()
                    == openrust::core::ProviderId::of::<SessionServiceProvider>())
                .count(),
            1
        );
        providers.push(Box::new(OriginalHostRoutes));
        providers
    }
    fn modules(config: &Self::Config) -> openrust::core::ModuleManifest {
        A::modules(config)
    }
}
pub async fn assert_original_host_cookie_session<A: Application>(
    source: Figment,
) -> Result<(), Box<dyn std::error::Error>> {
    let source = source.merge(figment::providers::Serialized::defaults(
        json!({"session":{"driver":"cookie","cookie":"original_host_session","secure":false}}),
    ));
    let mut app = TestApp::<OriginalHost<A>>::builder(source).build().await?;
    let outcome: openrust::Result<()> = async {
        let response = app
            .request_with_limits(
                Request::get("/__original-session/write")
                    .header("host", "localhost")
                    .body(Body::empty())
                    .map_err(openrust::Error::internal)?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(&response, json!({"value":"persisted","snapshot":true}))?;
        let pairs = cookie_pair(&response, "original_host_session")?;
        ensure(pairs.split("; ").count() == 2)?;
        for _ in 0..2 {
            let response = app
                .request_with_limits(
                    Request::get("/__original-session/read")
                        .header("host", "localhost")
                        .header(COOKIE, &pairs)
                        .body(Body::empty())
                        .map_err(openrust::Error::internal)?,
                    BODY_LIMIT,
                    REQUEST_TIMEOUT,
                )
                .await?;
            check_response(&response, json!({"value":"persisted","snapshot":true}))?;
        }
        Ok(())
    }
    .await;
    let stopped = app
        .shutdown(tokio::time::Instant::now() + REQUEST_TIMEOUT)
        .await;
    outcome?;
    stopped?;
    Ok(())
}

--- AGENTS.md ---
# 应用开发指南

本项目基于 OpenRust，普通 `cargo run` 启动应用，`cargo test` 执行测试。

`src/main.rs` 只负责入口；`bootstrap/app.rs` 装配应用，`routes/web.rs` 注册 HTTP 路由。`app/` 保留通用应用装配，业务放在 `modules/<业务>/`，配置在 `config/`，迁移与种子在 `database/`，资源在 `resources/`，公开文件在 `public/`，运行数据在 `storage/`。

本地依赖通过应用自身 Cargo.toml 的 workspace 配置解析；保持框架源码目录可达。`--grpc` 生成 proto/build.rs、Echo 服务与 `serve all` 联合运行命令；普通 `cargo run` 仍只启动 HTTP。配置 `config/grpc.toml` 的 TLS 证书和私钥后用 `cargo run -- serve all` 启动 HTTP 与 gRPC 两个端口；不配置 TLS 时 gRPC 启动会拒绝，只有本机开发或可信 TLS 终止拓扑才能显式开启明文。

`modules/mod.rs` 静态声明业务代码，并通过 `manifest(root)` 返回采用 `FileModuleActivator` 的公开 `ModuleManifest`；默认从运行工作目录读取 `modules_statuses.json`，与默认 `config/` 加载约定一致；部署时从应用根启动，不能把编译机路径当部署根。`bootstrap/app.rs` 的 `Application::modules` 使用此清单；模块的 `ModuleDescriptor` 引入普通 ServiceProvider，与框架共用唯一容器和 register/boot 生命周期。模块根使用部署时的应用目录；生成的 `Configuration.modules_root` 可显式指定运行根，`Application::modules` 把相同根传给状态文件和各模块 descriptor，不扫描 Rust 源码或在运行时自动加载 crate。启用状态文件默认是空对象 `{}`；只有对应名称的 JSON `true` 启用模块，缺少文件/键、`false` 或其他非 `true` 值均关闭，损坏 JSON 启动失败且不被自动覆写。状态变更只影响下次应用启动，不热卸载当前应用；管理写命令尚未实现。

模块专属配置、迁移、资源与测试留在该模块目录；现有根级生成器产物属于应用级职责，模块生成与资源发布等管理命令仍待后续实现。第三方依赖在本应用 Cargo.toml 管理，不在普通模块下放无效 Cargo.toml。
