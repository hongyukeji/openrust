--- tests/support/request_input.rs ---
//! 生成应用在公开 Provider 与 Request API 上的外部消费回归。
use figment::Figment;
use openrust::foundation::ApplicationDefinition;
use openrust::foundation::BootContext;
use openrust::http::axum::{
    body::Body,
    http::{Method, Request, StatusCode, header::CONTENT_TYPE},
};
use openrust::http::InputOutcome;
use openrust::http::Json;
use openrust::http::Request as InputRequest;
use openrust::routing::Router;
use openrust::http::UploadedFile;
use openrust::support::{ArrayKey, BackedEnum, DateOptions, InputNumber, TimezoneInput};
use openrust::support::{BoxFuture, ServiceProvider};
use openrust::testing::TestApp;
use std::time::Duration;

#[derive(Debug, PartialEq, Eq)]
enum Approval {
    Accepted,
}

impl BackedEnum for Approval {
    type Backing = i64;

    fn try_from_backing(value: i64) -> Option<Self> {
        (value == 1).then_some(Self::Accepted)
    }
}

struct InputRoutesProvider;

impl ServiceProvider for InputRoutesProvider {
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            app.routes(|routes: Router| {
                routes
                    .post("/test/request-input", inspect_input)
                    .post("/test/request-file", inspect_file)
                    .route(
                        "/test/request-url",
                        openrust::routing::methods::get(inspect_url).post(inspect_url),
                    )
                    .name("test.request-url")
            })?;
            Ok(())
        })
    }
}

// 生成项目从公开模块外接线读取文件，不依赖框架私有暂存路径。
async fn inspect_file(request: InputRequest) -> openrust::Result<Json<serde_json::Value>> {
    let file = request
        .file("document")?
        .ok_or_else(|| openrust::Error::custom("file_missing", "文件缺失"))?;
    let uploaded = file
        .downcast_ref::<UploadedFile>()
        .ok_or_else(|| openrust::Error::custom("file_invalid", "文件无效"))?;
    let mime = uploaded.mime_type().await?;
    let extension = uploaded.extension().await?;
    let selected = request.only(&["document"])?;
    let selected_file = selected
        .get("document")?
        .ok_or_else(|| openrust::Error::custom("file_missing", "选取结果缺失"))?;
    Ok(Json(serde_json::json!({
        "name": uploaded.client_original_name(),
        "mime": mime,
        "extension": extension,
        "bytes": uploaded.size(),
        "has_file": request.has_file("document")?,
        "same_object": file.same_object(selected_file),
        "text": request.input("label")?,
        "raw_len": request.content_len(),
    })))
}

// 保留生成应用的 Provider 与模块装配，只在本测试追加公开路由扩展。
struct InputApplication<A>(std::marker::PhantomData<fn() -> A>);

impl<A: ApplicationDefinition> ApplicationDefinition for InputApplication<A> {
    type Config = A::Config;

    fn config() -> openrust::config::ConfigManifest {
        A::config()
    }
    fn default_providers() -> openrust::support::DefaultProviders {
        A::default_providers()
    }
    fn package_providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        A::package_providers(config)
    }
    fn additional_providers() -> Vec<Box<dyn ServiceProvider>> {
        A::additional_providers()
    }
    fn with_bootstrap_providers() -> bool {
        A::with_bootstrap_providers()
    }

    fn config_namespace() -> &'static str {
        A::config_namespace()
    }

    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        providers.push(Box::new(InputRoutesProvider));
        providers
    }

    fn configure_providers(config: &Self::Config, builder: &mut openrust::foundation::ProviderBuilder) {
        A::configure_providers(config, builder);
    }
}

async fn inspect_input(request: InputRequest) -> openrust::Result<Json<serde_json::Value>> {
    let items = request.collect("items")?;
    let profile = request.fluent("profile")?;
    let date = request
        .date_with(
            "date",
            DateOptions {
                format: Some("!Y-m-d H:i:s"),
                timezone: Some(TimezoneInput::Name("Asia/Shanghai")),
            },
        )?
        .ok_or_else(|| openrust::Error::custom("test_date_missing", "测试日期缺失"))?;
    let interval = request
        .interval("interval")?
        .ok_or_else(|| openrust::Error::custom("test_interval_missing", "测试区间缺失"))?;
    let approval = request.enum_value::<Approval>("approval")?;
    let has_false_continues = matches!(
        request.when_has("zero", |_| Ok(false))?,
        InputOutcome::Request(_)
    );
    let missing_default_is_false = matches!(
        request.when_missing_or_else("zero", |_| Ok(true), || Ok(false))?,
        InputOutcome::Default(false)
    );

    Ok(Json(serde_json::json!({
        "string": request.string("name")?.to_string(),
        "null_string_default": request.string_or("nil", "fallback")?.to_string(),
        "missing_string_default": request.string_or("missing", "fallback")?.to_string(),
        "null_integer_default": request.integer_or("nil", 7)?,
        "missing_integer_default": request.integer_or("missing", 7)?,
        "float": request.float("float")?,
        "missing_boolean_default": request.boolean_or("missing", true)?,
        "approval": approval == Some(Approval::Accepted),
        "unknown_approval_default": request.enum_or("unknown_approval", Approval::Accepted)? == Approval::Accepted,
        "item_string_key": items.get(ArrayKey::from("02")).cloned(),
        "item_integer_key": items.get(2_i64).cloned(),
        "profile_name": profile.get("person.name")?,
        "clamped": request.clamp("score", InputNumber::Integer(0), InputNumber::Integer(10))?,
        "has_false_continues": has_false_continues,
        "missing_default_is_false": missing_default_is_false,
        "date": date.format("Y-m-d H:i:s P")?,
        "interval": {
            "years": interval.years,
            "months": interval.months,
            "days": interval.days,
            "hours": interval.hours,
            "minutes": interval.minutes,
            "seconds": interval.seconds,
            "microseconds": interval.microseconds,
            "total_days": interval.total_days(),
        }
    })))
}

// 捕获生成应用消费公开 URL API 时 query bag 与原始 URI 混淆的回归。
async fn inspect_url(mut request: InputRequest) -> openrust::Result<Json<serde_json::Value>> {
    let full_url = request.full_url()?;
    let route = request.route()?.ok_or_else(|| {
        openrust::Error::custom("generated_route_missing", "生成应用未发布匹配路由")
    })?;
    request.merge(serde_json::json!({"page": 3}))?;
    let merged = request.full_url_with_query(&serde_json::json!({"view": "compact"}))?;
    let without = request.full_url_without_query(&["label"])?;
    request.replace(serde_json::json!({"page": 4}))?;
    Ok(Json(serde_json::json!({
        "route_name": request.route_name()?,
        "route_is": request.route_is(&["other.*", "test.*"])?,
        "route_uri": route.uri(), "route_methods": route.methods(),
        "route_missing": request.route_parameter("missing")?,
        "route_default": request.route_parameter_or("missing", serde_json::json!("fallback"))?,
        "root": request.root()?, "url": request.url()?, "full_url": full_url,
        "after": request.full_url()?, "scheme": request.scheme()?,
        "http_host": request.http_host()?, "port": request.port()?,
        "base_url": request.base_url()?, "client_ip": request.client_ip()?,
        "client_ips": request.client_ips()?,
        "decoded_path": request.decoded_path()?, "segments": request.segments()?,
        "segment": request.segment(2)?, "zero": request.segment(0)?,
        "is": request.is(&["test/*"])?, "full_url_is": request.full_url_is(&["*/test/request-url*"])?,
        "prefetch": request.prefetch()?, "merged": merged, "without": without,
        "replaced": request.full_url_with_query(&serde_json::json!({"view": "compact"}))?,
    })))
}

/// 通过生成应用自身的 Provider 清单发送进程内请求，不代表 TCP 验收。
pub async fn assert_request_input<A: ApplicationDefinition>(
    source: Figment,
) -> Result<(), Box<dyn std::error::Error>> {
    let mut app = TestApp::<InputApplication<A>>::builder(source)
        .build()
        .await?;
    let result: Result<(), Box<dyn std::error::Error>> = async {
        let body = serde_json::json!({
            "name": "  Ada  ",
            "nil": null,
            "float": "2.5suffix",
            "approval": "1",
            "unknown_approval": 8,
            "items": {"02": "string", "2": "integer"},
            "profile": {"person": {"name": "Ada"}},
            "score": 14,
            "zero": 0,
            "date": "2024-03-10 12:30:40",
            "interval": "P1Y2M3DT4H5M6S"
        });
        let request = Request::builder()
            .method(Method::POST)
            .uri("/test/request-input")
            .header(CONTENT_TYPE, "application/json")
            .body(Body::from(serde_json::to_vec(&body)?))?;
        app.request(request)
            .await?
            .assert_status(StatusCode::OK)?
            .assert_json(&serde_json::json!({
                "success": true,
                "code": "ok",
                "message": "ok",
                "data": {
                "string": "Ada",
                "null_string_default": "",
                "missing_string_default": "fallback",
                "null_integer_default": 0,
                "missing_integer_default": 7,
                "float": 2.5,
                "missing_boolean_default": true,
                "approval": true,
                "unknown_approval_default": true,
                "item_string_key": "string",
                "item_integer_key": "integer",
                "profile_name": "Ada",
                "clamped": 10,
                "has_false_continues": true,
                "missing_default_is_false": true,
                "date": "2024-03-10 12:30:40 +08:00",
                "interval": {
                    "years": 1,
                    "months": 2,
                    "days": 3,
                    "hours": 4,
                    "minutes": 5,
                    "seconds": 6,
                    "microseconds": 0,
                    "total_days": null
                }
                }
            }))?;
        for (text, expected_float, expected_integer) in [
            (format!("0.{}1e20000", "0".repeat(19_999)), 0.1_f64, 0_i64),
            (format!("1{}e-20000", "0".repeat(20_000)), 10.0_f64, 10_i64),
        ] {
            let mut numeric = body.clone();
            numeric["float"] = serde_json::Value::String(text.clone());
            numeric["score"] = serde_json::Value::String(text.clone());
            numeric["nil"] = serde_json::Value::String(text);
            let response = app.request(Request::post("/test/request-input")
                .header(CONTENT_TYPE, "application/json")
                .body(Body::from(serde_json::to_vec(&numeric)?))?).await?;
            response.assert_status(StatusCode::OK)?;
            let output: serde_json::Value = serde_json::from_slice(response.body())?;
            assert_eq!(output["data"]["float"].as_f64().map(f64::to_bits), Some(expected_float.to_bits()));
            assert_eq!(output["data"]["null_integer_default"].as_i64(), Some(expected_integer));
            assert_eq!(output["data"]["clamped"].as_f64().map(f64::to_bits), Some(expected_float.to_bits()));
        }
        let multipart = concat!(
            "--generated\r\nContent-Disposition: form-data; name=\"label\"\r\n\r\npublic\r\n",
            "--generated\r\nContent-Disposition: form-data; name=\"document\"; filename=\"client.txt\"\r\nContent-Type: text/plain\r\n\r\nhello\r\n",
            "--generated--\r\n"
        );
        app.request(Request::builder()
            .method(Method::POST).uri("/test/request-file")
            .header(CONTENT_TYPE, "multipart/form-data; boundary=generated")
            .body(Body::from(multipart))?)
            .await?
            .assert_status(StatusCode::OK)?
            .assert_json(&serde_json::json!({
                "success": true,
                "code": "ok",
                "message": "ok",
                "data": {
                    "name": "client.txt", "mime": "text/plain", "extension": "txt",
                    "bytes": 5, "has_file": true,
                    "same_object": true, "text": "public", "raw_len": multipart.len()
                }
            }))?;
        for (method, json_source) in [
            (Method::GET, false),
            (Method::GET, true),
            (Method::POST, true),
        ] {
            let mutates_query = method == Method::GET && !json_source;
            let mut builder = Request::builder()
                .method(method)
                .uri("/test/request-url?page=1&label=public")
                .header("host", "example.test:8080")
                .header("purpose", "prefetch");
            if json_source {
                builder = builder.header(CONTENT_TYPE, "application/json");
            }
            let response = app
                .request(builder.body(if json_source {
                    Body::from(r#"{"secret":"body-only"}"#)
                } else {
                    Body::empty()
                })?)
                .await?;
            response.assert_status(StatusCode::OK)?;
            let json: serde_json::Value = serde_json::from_slice(response.body())?;
            let data = &json["data"];
            let base = "http://example.test:8080/test/request-url";
            assert_eq!(data["route_name"], "test.request-url");
            assert_eq!(data["route_is"], true);
            assert_eq!(data["route_uri"], "test/request-url");
            assert_eq!(
                data["route_methods"],
                serde_json::json!(["GET", "HEAD", "POST"])
            );
            assert_eq!(data["route_missing"], serde_json::Value::Null);
            assert_eq!(data["route_default"], "fallback");
            assert_eq!(data["root"], "http://example.test:8080");
            assert_eq!(data["url"], base);
            assert_eq!(data["full_url"], format!("{base}?label=public&page=1"));
            assert_eq!(data["after"], data["full_url"]);
            assert_eq!(data["scheme"], "http");
            assert_eq!(data["http_host"], "example.test:8080");
            assert_eq!(data["port"], 8080);
            assert_eq!(data["base_url"], "");
            assert_eq!(data["client_ip"], serde_json::Value::Null);
            assert_eq!(data["client_ips"], serde_json::json!([]));
            assert_eq!(data["decoded_path"], "test/request-url");
            assert_eq!(data["segments"], serde_json::json!(["test", "request-url"]));
            assert_eq!(data["segment"], "request-url");
            assert_eq!(data["zero"], serde_json::Value::Null);
            assert_eq!(data["is"], true);
            assert_eq!(data["full_url_is"], true);
            assert_eq!(data["prefetch"], true);
            let page = if mutates_query { 3 } else { 1 };
            assert_eq!(
                data["merged"],
                format!("{base}?page={page}&label=public&view=compact")
            );
            assert_eq!(data["without"], format!("{base}?page={page}"));
            let replaced = if mutates_query {
                format!("{base}?page=4&view=compact")
            } else {
                format!("{base}?page=1&label=public&view=compact")
            };
            assert_eq!(data["replaced"], replaced);
        }
        Ok(())
    }
    .await;
    let shutdown = app
        .shutdown(openrust::tokio::time::Instant::now() + Duration::from_secs(5))
        .await;
    result?;
    shutdown?;
    Ok(())
}

--- tests/support/message_bags.rs ---
//! 生成应用通过公开 Provider 挂载业务路由，消费错误消息包契约。
use figment::Figment;
use openrust::foundation::ApplicationDefinition;
use openrust::foundation::BootContext;
use openrust::http::axum::{
    body::Body,
    http::{Request, StatusCode},
};
use openrust::http::Json;
use openrust::routing::Router;
use openrust::support::{
    ArrayKey, Collection, MessageBag, MessageInput, MessageJsonOptions, MessageKeys, MessageLookup,
    MessageValue, ViewErrorBag,
};
use openrust::support::{BoxFuture, ServiceProvider};
use openrust::testing::TestApp;
use serde_json::{Value, json};
use std::time::Duration;

const PATH: &str = "/__framework_contract/message-bags";

struct MessageBagRoutes;
impl ServiceProvider for MessageBagRoutes {
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            app.routes(|routes: Router| routes.get(PATH, inspect_message_bags))?;
            Ok(())
        })
    }
}

// 测试扩展保留生成应用原有 Provider 与模块清单。
struct MessageBagApplication<A>(std::marker::PhantomData<fn() -> A>);
impl<A: ApplicationDefinition> ApplicationDefinition for MessageBagApplication<A> {
    type Config = A::Config;

    fn config() -> openrust::config::ConfigManifest {
        A::config()
    }
    fn default_providers() -> openrust::support::DefaultProviders {
        A::default_providers()
    }
    fn package_providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        A::package_providers(config)
    }
    fn additional_providers() -> Vec<Box<dyn ServiceProvider>> {
        A::additional_providers()
    }
    fn with_bootstrap_providers() -> bool {
        A::with_bootstrap_providers()
    }

    fn config_namespace() -> &'static str {
        A::config_namespace()
    }

    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        providers.push(Box::new(MessageBagRoutes));
        providers
    }

    fn configure_providers(config: &Self::Config, builder: &mut openrust::foundation::ProviderBuilder) {
        A::configure_providers(config, builder);
    }
}

async fn inspect_message_bags() -> openrust::Result<Json<Value>> {
    let empty = MessageBag::new();
    let messages = Collection::try_from_entries([
        (ArrayKey::from(0_i64), "required".to_owned()),
        (ArrayKey::from(1_i64), "required".to_owned()),
        (ArrayKey::from(2_i64), "汉/a".to_owned()),
    ])?;
    let mut bag =
        MessageBag::try_from_messages([(ArrayKey::from("email"), MessageInput::Many(messages))])?;
    bag.add("email", "required")?;
    bag.add("email", "invalid")?;
    let raw = bag.messages().to_value()?;
    let formatted = match bag.get("email", Some("[:key] :message"))? {
        MessageLookup::Exact(values) => values.to_value()?,
        _ => {
            return Err(openrust::Error::custom(
                "generated_message_bag_shape",
                "消息形状不符",
            ));
        }
    };
    let first = bag.first(Some("email"), None)?;
    let has = bag.has(MessageKeys::Keys(vec![ArrayKey::from("email")]))?;
    let json = bag.to_json(
        MessageJsonOptions::UNESCAPED_UNICODE.union(MessageJsonOptions::UNESCAPED_SLASHES),
    )?;

    // 递归合并同名内层键会产生真实嵌套值；按 PHP 边界读取各方法结果。
    let mut nested = MessageBag::new();
    for message in ["x", "y"] {
        let incoming = Collection::try_from_entries([(
            ArrayKey::from("field"),
            Collection::try_from_entries([(
                ArrayKey::from("label"),
                MessageValue::Text(message.to_owned()),
            )])?,
        )])?;
        nested.merge(&incoming)?;
    }
    let nested_get = match nested.get("field", None)? {
        MessageLookup::Exact(values) => values.to_value()?,
        _ => {
            return Err(openrust::Error::custom(
                "generated_nested_message_shape",
                "嵌套消息形状不符",
            ));
        }
    };
    let nested_raw = nested.messages().to_value()?;
    let nested_json = nested.to_json(MessageJsonOptions::NONE)?;
    let nested_count = nested.count();
    let nested_first = nested.first(Some("field"), None)?;
    let nested_all_error = nested.all(None).is_err();

    let numeric = MessageBag::try_from_messages([(
        ArrayKey::from("numeric"),
        MessageInput::Many(Collection::try_from_entries([
            (ArrayKey::from(0_i64), "1e1000".to_owned()),
            (ArrayKey::from(1_i64), "1e-1000".to_owned()),
            (ArrayKey::from(2_i64), "1.0".to_owned()),
        ])?),
    )])?;
    let numeric_json = numeric.to_json(MessageJsonOptions::NUMERIC_CHECK)?;
    let mut numeric_add = MessageBag::new();
    for message in [
        "9223372036854775808",
        "9223372036854775809",
        "9223372036854775808",
    ] {
        numeric_add.add("reference", message)?;
    }

    let mut errors = ViewErrorBag::new();
    errors.put("sign.in", Box::new(bag))?;
    let named = errors
        .get_bag("sign.in")
        .as_bag()
        .first(Some("email"), None)?;
    let missing = errors.get_bag("missing").as_bag().is_empty();
    let count_without_default = errors.count();
    errors.put(
        "default",
        Box::new(MessageBag::try_from_messages([(
            ArrayKey::from("title"),
            MessageInput::One("missing".to_owned()),
        )])?),
    )?;

    Ok(Json(json!({
        "empty_json": empty.to_json(MessageJsonOptions::NONE)?,
        "raw": raw,
        "formatted": formatted,
        "first": first,
        "has": has,
        "json": json,
        "named": named,
        "nested_raw": nested_raw,
        "nested_get": nested_get,
        "nested_json": nested_json,
        "nested_count": nested_count,
        "nested_first": nested_first,
        "nested_all_error": nested_all_error,
        "numeric_json": numeric_json,
        "numeric_add": numeric_add.messages().to_value()?,
        "missing_is_empty": missing,
        "named_exists": errors.has_bag("sign.in"),
        "count_without_default": count_without_default,
        "default_count": errors.count(),
        "default_first": errors.default_first(Some("title"), None)?,
    })))
}

/// 经生成应用的真实 Provider 与 TestApp 请求入口验证消息包公开能力。
pub async fn assert_message_bags<A: ApplicationDefinition>(
    source: Figment,
) -> Result<(), Box<dyn std::error::Error>> {
    let mut app = TestApp::<MessageBagApplication<A>>::builder(source)
        .build()
        .await?;
    let result: Result<(), Box<dyn std::error::Error>> = async {
        let response = app
            .request(
                Request::builder()
                    .uri(PATH)
                    .header("host", "example.test")
                    .body(Body::empty())?,
            )
            .await?;
        response.assert_status(StatusCode::OK)?.assert_json(&json!({
            "success": true,
            "code": "ok",
            "message": "ok",
            "data": {
                "empty_json": "[]",
                "raw": {"email": {"0": "required", "2": "汉/a", "3": "invalid"}},
                "formatted": {"0": "[email] required", "2": "[email] 汉/a", "3": "[email] invalid"},
                "first": "required",
                "has": true,
                "json": "{\"email\":{\"0\":\"required\",\"2\":\"汉/a\",\"3\":\"invalid\"}}",
                "named": "required",
                "nested_raw": {"field": {"label": ["x", "y"]}},
                "nested_get": {"label": ["x", "y"]},
                "nested_json": "{\"field\":{\"label\":[\"x\",\"y\"]}}",
                "nested_count": 3,
                "nested_first": "x",
                "nested_all_error": true,
                "numeric_json": "{\"numeric\":[\"1e1000\",0,1]}",
                "numeric_add": {"reference": ["9223372036854775808", "9223372036854775809"]},
                "missing_is_empty": true,
                "named_exists": true,
                "count_without_default": 0,
                "default_count": 1,
                "default_first": "missing"
            }
        }))?;
        Ok(())
    }
    .await;
    let shutdown = app
        .shutdown(openrust::tokio::time::Instant::now() + Duration::from_secs(5))
        .await;
    result?;
    shutdown?;
    Ok(())
}

--- tests/support/request_cookie.rs ---
//! 生成应用经正式 Provider、请求读取与响应中间件验证 Cookie 契约。
use figment::Figment;
use openrust::config::SessionConfig;
use openrust::foundation::ApplicationDefinition;
use openrust::foundation::BootContext;
use openrust::http::axum::{
    Extension,
    body::Body,
    http::{
        HeaderValue, Request, StatusCode,
        header::{COOKIE, SET_COOKIE},
    },
    response::IntoResponse,
};
use openrust::http::Cookie;
use openrust::http::CookieJar;
use openrust::http::CookieOptions;
use openrust::http::CookieResponseExt;
use openrust::http::Json;
use openrust::http::RequestInfo;
use openrust::routing::RouteGroup;
use openrust::routing::Router;
use openrust::http::SameSite;
use openrust::session::Session;
use openrust::support::{BoxFuture, ServiceProvider};
use openrust::testing::{TestApp, TestResponse};
use serde_json::{Value, json};
use std::time::{Duration, SystemTime, UNIX_EPOCH};

const PREFIX: &str = "/__framework_contract/request-cookie";
const NAMES: [&str; 3] = ["contract_queued", "contract_direct", "contract_many"];
const VALUES: [&str; 3] = ["queued;plus+value", "direct;plus+value", "many;plus+value"];

struct CookieRoutesProvider;

impl ServiceProvider for CookieRoutesProvider {
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            let session = app.is_bound::<openrust::session::SessionStoreHandle>();
            app.routes(move |routes: Router| {
                let group = RouteGroup::new().middleware_alias("cookies");
                let group = if session {
                    group.middleware_alias("session")
                } else {
                    group
                };
                routes.group(group, |routes| {
                    routes
                        .get(&format!("{PREFIX}/set"), set_cookies)
                        .get(&format!("{PREFIX}/inspect"), inspect_cookies)
                        .get(&format!("{PREFIX}/forget"), forget_cookies)
                })
            })?;
            Ok(())
        })
    }
}

// 透传生成应用的正式服务和模块，仅追加本测试独占的路由 Provider。
struct CookieApplication<A>(std::marker::PhantomData<fn() -> A>);

impl<A: ApplicationDefinition> ApplicationDefinition for CookieApplication<A> {
    type Config = A::Config;

    fn config() -> openrust::config::ConfigManifest {
        A::config()
    }
    fn default_providers() -> openrust::support::DefaultProviders {
        A::default_providers()
    }
    fn package_providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        A::package_providers(config)
    }
    fn additional_providers() -> Vec<Box<dyn ServiceProvider>> {
        A::additional_providers()
    }
    fn with_bootstrap_providers() -> bool {
        A::with_bootstrap_providers()
    }

    fn config_namespace() -> &'static str {
        A::config_namespace()
    }

    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        providers.push(Box::new(CookieRoutesProvider));
        providers
    }

    fn configure_providers(
        config: &Self::Config,
        builder: &mut openrust::foundation::ProviderBuilder,
    ) {
        A::configure_providers(config, builder);
    }
}

fn options() -> CookieOptions {
    CookieOptions {
        path: Some(PREFIX.into()),
        secure: Some(false),
        same_site: Some(SameSite::Strict),
        ..CookieOptions::default()
    }
}

async fn set_cookies(
    jar: CookieJar,
    session: Option<Extension<Session>>,
) -> openrust::Result<impl IntoResponse> {
    let factory = jar.factory();
    jar.queue(factory.make(NAMES[0], VALUES[0], 5, options())?)?;
    let mut response = Json(json!({"queued": true, "direct": true, "many": true}))
        .with_cookie(factory.make(NAMES[1], VALUES[1], 5, options())?)?
        .with_cookies([factory.make(NAMES[2], VALUES[2], 5, options())?])?
        .into_response();
    if let Some(Extension(session)) = session {
        response.headers_mut().insert(
            "x-contract-session-name",
            HeaderValue::from_str(&session.name()?).map_err(openrust::Error::internal)?,
        );
    }
    Ok(response)
}

async fn inspect_cookies(info: RequestInfo) -> Json<Value> {
    // 仅比较固定测试叶；不把原始 Cookie 或原始请求头写入响应。
    Json(json!({
        "queued": info.cookie(NAMES[0]) == Some(json!(VALUES[0])),
        "direct": info.cookie(NAMES[1]) == Some(json!(VALUES[1])),
        "many": info.cookie(NAMES[2]) == Some(json!(VALUES[2])),
        "present": info.has_cookie(NAMES[0]),
        "missing_default": info.cookie_or("contract_missing", json!("fallback")) == json!("fallback")
    }))
}

async fn forget_cookies(jar: CookieJar) -> openrust::Result<impl IntoResponse> {
    jar.expire(NAMES[0], options())?;
    Json(json!({"forgotten": true}))
        .with_cookie(jar.factory().forget(NAMES[1], options())?)?
        .with_cookies([jar.factory().forget(NAMES[2], options())?])
}

/// 在生成应用自身的正式 Provider 和中间件链路验证 Cookie；不替代真实 TCP 验收。
pub async fn assert_request_cookie<A: ApplicationDefinition>(
    source: Figment,
    expect_session: bool,
    check_wire: impl FnOnce(&[String]) -> openrust::Result<()>,
) -> openrust::Result<()> {
    let mut app = TestApp::<CookieApplication<A>>::builder(source)
        .build()
        .await?;
    let outcome: openrust::Result<()> = async {
        let response = app.request(request("set", None)?).await?;
        check_response(
            &response,
            json!({"queued": true, "direct": true, "many": true}),
        )?;
        let session_name = session_name(&response, expect_session)?;
        let session_config = if expect_session {
            Some(
                app.app()?
                    .section::<SessionConfig>("session")
                    .map_err(openrust::Error::internal)?,
            )
        } else {
            None
        };
        let mut pairs = check_cookie_headers(
            &response,
            false,
            session_name.as_deref().zip(session_config.as_ref()),
        )?;
        check_wire(&pairs)?;
        let cookie_header = pairs.join("; ");

        let response = app
            .request(request("inspect", Some(&cookie_header))?)
            .await?;
        check_response(&response, inspection(true))?;
        if let Some(pair) = check_session_only(
            &response,
            session_name.as_deref().zip(session_config.as_ref()),
        )? {
            *pairs.get_mut(NAMES.len()).ok_or_else(mismatch)? = pair;
        }
        let cookie_header = pairs.join("; ");

        // 不携带上次 Cookie 的请求既无读取值，也不能收到上次请求的队列。
        let response = app.request(request("inspect", None)?).await?;
        check_response(&response, inspection(false))?;
        check_session_only(
            &response,
            session_name.as_deref().zip(session_config.as_ref()),
        )?;

        let response = app
            .request(request("forget", Some(&cookie_header))?)
            .await?;
        check_response(&response, json!({"forgotten": true}))?;
        check_cookie_headers(
            &response,
            true,
            session_name.as_deref().zip(session_config.as_ref()),
        )?;

        let response = app.request(request("inspect", None)?).await?;
        check_response(&response, inspection(false))?;
        check_session_only(
            &response,
            session_name.as_deref().zip(session_config.as_ref()),
        )?;
        Ok(())
    }
    .await;
    // 业务检查仅返回 Result，保证失败也进入应用关闭流程。
    let shutdown = app
        .shutdown(openrust::tokio::time::Instant::now() + Duration::from_secs(5))
        .await;
    outcome?;
    shutdown?;
    Ok(())
}

fn inspection(present: bool) -> Value {
    json!({"queued": present, "direct": present, "many": present, "present": present, "missing_default": true})
}

fn request(action: &str, cookies: Option<&str>) -> openrust::Result<Request<Body>> {
    let mut builder = Request::builder()
        .uri(format!("{PREFIX}/{action}"))
        .header("host", "localhost");
    if let Some(cookies) = cookies {
        builder = builder.header(COOKIE, cookies);
    }
    builder
        .body(Body::empty())
        .map_err(openrust::Error::internal)
}

fn check_response(response: &TestResponse, data: Value) -> openrust::Result<()> {
    response
        .assert_status(StatusCode::OK)?
        .assert_json(&json!({
            "success": true, "code": "ok", "message": "ok", "data": data
        }))?;
    Ok(())
}

fn session_name(response: &TestResponse, expected: bool) -> openrust::Result<Option<String>> {
    let mut values = response.headers().get_all("x-contract-session-name").iter();
    let name = values
        .next()
        .map(|value| value.to_str().map(str::to_owned))
        .transpose()
        .map_err(|_| mismatch())?;
    ensure(values.next().is_none() && name.is_some() == expected)?;
    Ok(name)
}

fn check_cookie_headers(
    response: &TestResponse,
    deletion: bool,
    session: Option<(&str, &SessionConfig)>,
) -> openrust::Result<Vec<String>> {
    let mut pairs = Vec::new();
    let now = i64::try_from(
        SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .map_err(|_| mismatch())?
            .as_secs(),
    )
    .map_err(|_| mismatch())?;
    for name in NAMES {
        let mut matching = response
            .headers()
            .get_all(SET_COOKIE)
            .iter()
            .filter_map(|header| {
                let header = header.to_str().ok()?;
                let pair = header.split(';').next()?;
                (pair.split_once('=').map(|(key, _)| key) == Some(name)).then_some((header, pair))
            });
        let (header, pair) = matching.next().ok_or_else(mismatch)?;
        ensure(matching.next().is_none())?;
        let model = Cookie::from_header(header)?;
        ensure(model.name() == name && model.path() == PREFIX)?;
        ensure(model.http_only() && model.secure() == Some(false))?;
        ensure(model.same_site() == Some(SameSite::Strict))?;
        let expires = model.expires().ok_or_else(mismatch)?.unix_timestamp();
        let max_age = header
            .split(';')
            .skip(1)
            .find_map(|attribute| {
                let (key, value) = attribute.trim().split_once('=')?;
                key.eq_ignore_ascii_case("max-age").then_some(value)
            })
            .ok_or_else(mismatch)?
            .parse::<i64>()
            .map_err(|_| mismatch())?;
        if deletion {
            ensure(expires < now && max_age == 0)?;
        } else {
            ensure(expires > now && max_age > 0 && max_age <= 300)?;
        }
        // 第一段逐字保留，原样回送给应用，支持明文或经认证的载荷。
        pairs.push(pair.to_owned());
    }
    let mut total = 0;
    let mut session_count = 0;
    for value in response.headers().get_all(SET_COOKIE) {
        total += 1;
        let header = value.to_str().map_err(|_| mismatch())?;
        let pair = header.split(';').next().ok_or_else(mismatch)?;
        let (name, value) = pair.split_once('=').ok_or_else(mismatch)?;
        if NAMES.contains(&name) {
            continue;
        }
        let (expected_name, config) = session.ok_or_else(mismatch)?;
        ensure(name == expected_name && !value.is_empty())?;
        check_session_cookie(header, expected_name, config)?;
        pairs.push(pair.to_owned());
        session_count += 1;
    }
    ensure(session_count == usize::from(session.is_some()))?;
    ensure(total == NAMES.len() + session_count)?;
    Ok(pairs)
}

fn check_session_only(
    response: &TestResponse,
    session: Option<(&str, &SessionConfig)>,
) -> openrust::Result<Option<String>> {
    let mut count = 0;
    let mut pair = None;
    for header in response.headers().get_all(SET_COOKIE) {
        let header = header.to_str().map_err(|_| mismatch())?;
        let first = header.split(';').next().ok_or_else(mismatch)?;
        let (name, value) = first.split_once('=').ok_or_else(mismatch)?;
        let (expected_name, config) = session.ok_or_else(mismatch)?;
        ensure(name == expected_name && !value.is_empty())?;
        check_session_cookie(header, expected_name, config)?;
        pair = Some(first.to_owned());
        count += 1;
    }
    ensure(count == usize::from(session.is_some()))?;
    Ok(pair)
}

fn check_session_cookie(header: &str, name: &str, config: &SessionConfig) -> openrust::Result<()> {
    let model = Cookie::from_header(header)?;
    ensure(model.name() == name && model.path() == config.path)?;
    if let Some(explicit) = config.cookie.as_deref() {
        ensure(name == explicit)?;
    }
    let domain = config
        .domain
        .as_deref()
        .filter(|value| !value.is_empty() && *value != "0");
    ensure(model.domain() == domain)?;
    // TestApp 发送普通本机 HTTP；未设置 Secure 时可信传输默认值为 false。
    ensure(model.secure() == Some(config.secure.unwrap_or(false)))?;
    ensure(model.http_only() == config.http_only)?;
    let same_site = match config
        .same_site
        .as_deref()
        .map(str::to_ascii_lowercase)
        .as_deref()
    {
        None => None,
        Some("lax") => Some(SameSite::Lax),
        Some("strict") => Some(SameSite::Strict),
        Some("none") => Some(SameSite::None),
        _ => return Err(mismatch()),
    };
    ensure(model.same_site() == same_site)?;
    let attributes = header.to_ascii_lowercase();
    ensure(
        attributes
            .split(';')
            .any(|part| part.trim() == "partitioned")
            == config.partitioned,
    )?;
    let max_age = header.split(';').skip(1).find_map(|attribute| {
        let (key, value) = attribute.trim().split_once('=')?;
        key.eq_ignore_ascii_case("max-age").then_some(value)
    });
    if config.expire_on_close {
        ensure(model.expires().is_none() && max_age.is_none())?;
    } else {
        let age = max_age
            .ok_or_else(mismatch)?
            .parse::<i64>()
            .map_err(|_| mismatch())?;
        let lifetime = i64::try_from(config.lifetime).map_err(|_| mismatch())?;
        ensure(model.expires().is_some() && age > 0 && age <= lifetime.saturating_mul(60))?;
    }
    Ok(())
}

fn ensure(condition: bool) -> openrust::Result<()> {
    if condition { Ok(()) } else { Err(mismatch()) }
}

fn mismatch() -> openrust::Error {
    openrust::Error::custom(
        "test_cookie_contract_mismatch",
        "生成应用 Cookie 契约不匹配",
    )
}

--- tests/support/request_session.rs ---
//! 生成应用经正式 Session Provider 与请求作用域验证跨请求生命周期。
use figment::Figment;
use openrust::config::SessionConfig;
use openrust::foundation::ApplicationDefinition;
use openrust::foundation::BootContext;
use openrust::foundation::RegisterContext;
use openrust::http::axum::{
    body::Body,
    http::{
        Request, StatusCode,
        header::{COOKIE, SET_COOKIE},
    },
};
use openrust::http::CookieFactory;
use openrust::http::CookieJar;
use openrust::http::CookieOptions;
use openrust::http::Inject;
use openrust::http::Json;
use openrust::http::RequestInfo;
use openrust::routing::RouteGroup;
use openrust::routing::Router;
use openrust::session::{
    CookieSessionStore, DatabaseSessionStore, GuardedDatabaseSessionStore, MemorySessionStore,
    Session, SessionId, SessionRecord, SessionRequestContext, SessionServiceProvider, SessionStore,
    SessionStoreHandle, SessionWriteMode, SessionWriteOutcome,
};
use openrust::support::{BoxFuture, ServiceProvider};
use openrust::support::{DataObject, DataValue, ObjectEncoding};
use openrust::testing::{TestApp, TestResponse};
use serde_json::{Value, json};
use std::any::Any;
use std::sync::{
    Arc,
    atomic::{AtomicUsize, Ordering},
};
use std::time::Duration;
use time::OffsetDateTime;

const PREFIX: &str = "/__framework_contract/request-session";
const NOTICE: &str = "contract.request_session.notice";
const NOW: &str = "contract.request_session.now";
const NULL: &str = "contract.request_session.null";
const SHARED: &str = "contract.request_session.shared";
const PREFERENCE: &str = "contract.request_session.preference";
const MEMO: &str = "contract.request_session.memo";
const LIST: &str = "contract.request_session.list";
const COUNT: &str = "contract.request_session.count";
const BODY_LIMIT: usize = 4096;
const REQUEST_TIMEOUT: Duration = Duration::from_secs(5);

struct SessionRoutes;
#[derive(Default)]
struct PreviousCalls(AtomicUsize);
#[derive(Default)]
struct OldInputCalls(AtomicUsize);

impl ServiceProvider for SessionRoutes {
    fn register<'a>(
        &'a self,
        app: &'a mut RegisterContext<'_>,
    ) -> openrust::support::BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            app.instance(Arc::new(PreviousCalls::default())).await?;
            app.instance(Arc::new(OldInputCalls::default())).await?;
            // fixture 已明确选择 plain array 或 auth database；不是装饰任意已有 factory。
            app.singleton::<SessionStoreHandle, _>(|resolver| {
                Box::pin(async move {
                    let config = resolver.section::<SessionConfig>("session")?;
                    let backend: Arc<dyn SessionStore> = match config.driver.as_deref() {
                        Some("array") => Arc::new(MemorySessionStore::default()),
                        Some("cookie") => Arc::new(CookieSessionStore::new(
                            config.lifetime,
                            config.expire_on_close,
                        )?),
                        Some(driver @ ("database" | "database-guarded")) => {
                            let db = if let Some(connection) = &config.connection {
                                resolver
                                    .resolve::<openrust::database::Databases>()
                                    .await?
                                    .get(connection)?
                            } else {
                                (*resolver.resolve::<openrust::database::Db>().await?).clone()
                            };
                            if driver == "database" {
                                Arc::new(
                                    DatabaseSessionStore::new(db)
                                        .configured(config.table.clone(), config.lifetime)?,
                                )
                            } else {
                                Arc::new(
                                    GuardedDatabaseSessionStore::new(db)
                                        .for_table(config.table.clone())?,
                                )
                            }
                        }
                        _ => return Err(mismatch()),
                    };
                    Ok(Arc::new(SessionStoreHandle::new(ContractRequestDriver {
                        backend,
                        context: None,
                    })))
                })
            })
            .await?;
            Ok(())
        })
    }
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            app.routes(|routes: Router| {
                routes.group(
                    RouteGroup::new()
                        .middleware_alias("cookies")
                        .middleware_alias("session"),
                    |routes| {
                        routes
                            .get(&format!("{PREFIX}/set"), set)
                            .get(&format!("{PREFIX}/inspect"), inspect)
                            .get(&format!("{PREFIX}/advance"), advance)
                            .get(&format!("{PREFIX}/remove"), remove)
                            .get(&format!("{PREFIX}/seed-one"), seed_one)
                            .get(&format!("{PREFIX}/seed-two"), seed_two)
                            .get(&format!("{PREFIX}/probe"), probe)
                            .post(&format!("{PREFIX}/old-input"), save_old_input)
                            .get(&format!("{PREFIX}/old-input"), read_old_input)
                            .post(&format!("{PREFIX}/old-input/default"), save_all_old_input)
                            .get(&format!("{PREFIX}/previous/named"), previous_visit)
                            .name("contract.session.previous.named")
                            .get(&format!("{PREFIX}/previous/anonymous"), previous_visit)
                            .post(&format!("{PREFIX}/previous/read"), previous_read)
                            .group(
                                RouteGroup::new()
                                    .prefix(format!("{PREFIX}/previous"))
                                    .middleware_alias("precognitive"),
                                |routes| routes.get("/preview", previous_visit),
                            )
                            .group(
                                RouteGroup::new()
                                    .prefix(format!("{PREFIX}/old-input"))
                                    .middleware_alias("precognitive"),
                                |routes| routes.post("/preview", save_old_input),
                            )
                    },
                )
            })?;
            Ok(())
        })
    }
}

struct SessionApplication<A, const EXISTING: bool>(std::marker::PhantomData<fn() -> A>);
impl<A: ApplicationDefinition, const EXISTING: bool> ApplicationDefinition for SessionApplication<A, EXISTING> {
    type Config = A::Config;

    fn config() -> openrust::config::ConfigManifest {
        A::config()
    }
    fn default_providers() -> openrust::support::DefaultProviders {
        // 同类型 Provider 保留先登记项；显式测试 driver 必须先排除默认 Session。
        let providers = A::default_providers();
        if EXISTING {
            providers
        } else {
            providers.except([openrust::foundation::ProviderId::of::<SessionServiceProvider>()])
        }
    }
    fn package_providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        A::package_providers(config)
    }
    fn additional_providers() -> Vec<Box<dyn ServiceProvider>> {
        A::additional_providers()
    }
    fn with_bootstrap_providers() -> bool {
        A::with_bootstrap_providers()
    }
    fn config_namespace() -> &'static str {
        A::config_namespace()
    }
    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        if !EXISTING
            && !providers.iter().any(|provider| {
                provider.id() == openrust::foundation::ProviderId::of::<SessionServiceProvider>()
            })
        {
            // plain 没有正式 Session 时才显式安装内存 driver；Cookie Provider 完整保留。
            providers.push(Box::new(
                SessionServiceProvider::with_store(MemorySessionStore::default())
                    .with_cookie_config(SessionConfig {
                        lottery: [1, 1],
                        driver: Some("array".into()),
                        cookie: Some("contract_session".into()),
                        secure: Some(false),
                        ..SessionConfig::default()
                    }),
            ));
        }
        providers.push(Box::new(SessionRoutes));
        providers
    }
    fn configure_providers(config: &Self::Config, builder: &mut openrust::foundation::ProviderBuilder) {
        A::configure_providers(config, builder);
    }
}

async fn set(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    let before = session.id()?;
    session.set_id(Some(before.as_str()))?;
    let actual = session.handler()?;
    ensure(Arc::ptr_eq(&actual, &session.set_handler(actual.clone())?))?;
    ensure(session.handler_needs_request()?)?;
    session.set_id(None)?;
    ensure(session.id()? != before)?;
    // 原始 Session 值在请求内保留，响应边界再显式转成 JSON。
    session
        .put(
            PREFERENCE,
            openrust::support::DataValue::from_json(json!("preserved"))?,
        )?
        .put_typed(NULL, Value::Null)?
        .flash_typed(NOTICE, "next")?
        .now_typed(NOW, "current")?;
    info.session()?.put_typed(SHARED, "same request")?;
    session.put_typed(MEMO, Value::Null)?;
    session.remember_typed(MEMO, || Ok("computed"))?;
    session.push_typed(LIST, "first")?;
    session.increment(COUNT)?;
    Ok(Json(snapshot(&session, &info)?))
}
async fn inspect(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    Ok(Json(snapshot(&session, &info)?))
}

async fn previous_visit(
    session: Session,
    info: RequestInfo,
    Inject(calls): Inject<PreviousCalls>,
) -> openrust::Result<Json<Value>> {
    calls.0.fetch_add(1, Ordering::SeqCst);
    previous_read(session, info, Inject(calls)).await
}

async fn previous_read(
    session: Session,
    info: RequestInfo,
    Inject(calls): Inject<PreviousCalls>,
) -> openrust::Result<Json<Value>> {
    Ok(Json(json!({
        "url":session.previous_url()?, "route":session.previous_route()?,
        "route_exists":session.exists(&["_previous.route"])?,
        "attempting":info.is_attempting_precognition()?, "confirmed":info.is_precognitive(),
        "business_calls":calls.0.load(Ordering::SeqCst)
    })))
}
async fn advance(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    session.remember_typed(MEMO, || Ok("unexpected"))?;
    session.push_typed(LIST, "second")?;
    session.increment_by(COUNT, 2)?;
    session.decrement(COUNT)?;
    session.decrement_by(COUNT, 2)?;
    Ok(Json(snapshot(&session, &info)?))
}
async fn remove(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    let removed = session
        .remove(MEMO)?
        .map(|value| value.to_json())
        .transpose()?;
    let mut data = snapshot(&session, &info)?;
    data["removed"] = json!(removed);
    Ok(Json(data))
}
async fn save_old_input(
    Inject(calls): Inject<OldInputCalls>,
    request: openrust::http::Request,
) -> openrust::Result<Json<Value>> {
    calls.0.fetch_add(1, Ordering::SeqCst);
    request.flash_except(&["password"])?;
    read_old_input(request.info().clone(), Inject(calls)).await
}
async fn save_all_old_input(
    Inject(calls): Inject<OldInputCalls>,
    request: openrust::http::Request,
) -> openrust::Result<Json<Value>> {
    calls.0.fetch_add(1, Ordering::SeqCst);
    request.flash()?;
    read_old_input(request.info().clone(), Inject(calls)).await
}
async fn read_old_input(
    info: RequestInfo,
    Inject(calls): Inject<OldInputCalls>,
) -> openrust::Result<Json<Value>> {
    Ok(Json(
        json!({"all":info.old_all_json()?,"name":info.old_json("name")?,
        "missing":info.old_or_json("missing", json!("fallback"))?,
        "business_calls":calls.0.load(Ordering::SeqCst)}),
    ))
}
fn snapshot(session: &Session, info: &RequestInfo) -> openrust::Result<Value> {
    Ok(json!({
        "cookie_name": session.name()?,
        "same_handle": info.has_session() && info.session()?.id()? == session.id()?,
        "shared_value": session.get_json(SHARED)? == Some(json!("same request")),
        "stored_null": session.get_or(NULL, openrust::support::DataValue::from_json(json!("fallback"))?)?.is_null(),
        "preference": session.get(PREFERENCE)?.map(|value| value.to_json()).transpose()?,
        "notice": session.get_json(NOTICE)?,
        "now": session.get_json(NOW)?,
        "memo": session.get_json(MEMO)?,
        "list": session.get_json(LIST)?,
        "count": session.get_json(COUNT)?,
    }))
}

/// 在正式生成应用内验证 Session；不是网络或存储 driver 的替代验收。
///
/// `existing_session=true` 保留认证 Provider 并显式选择同 Db 委托驱动；false 仅为没有
/// Session 的 plain 应用追加显式内存 driver。此参数不表示 Cookie 是否加密，
/// 响应不返回 ID/token，ID 仅在处理器内比较句柄；Set-Cookie 首段只逐字传入
/// 后续请求，不解密也不打印。
pub async fn assert_request_session<A: ApplicationDefinition>(
    source: Figment,
    existing_session: bool,
) -> openrust::Result<()> {
    // 代码配置来源使用 Global profile；测试策略也须显式覆盖同一最高层。
    let source = source.merge(figment::providers::Serialized::globals(
        json!({"session":{"lottery":[1,1]}}),
    ));
    let cookie_source = source.clone().merge(figment::providers::Serialized::globals(
        json!({"session":{"driver":"cookie","cookie":"contract_cookie_session","secure":false}}),
    ));
    if existing_session {
        verify::<A, true>(source).await?;
    } else {
        verify::<A, false>(source).await?;
    }
    // 独立应用显式选择 Cookie driver；不改变原宿主/Auth 的数据库配置或 driver。
    verify::<CookieSessionApplication<A>, true>(cookie_source).await
}

struct CookieSessionApplication<A>(std::marker::PhantomData<fn() -> A>);
impl<A: ApplicationDefinition> ApplicationDefinition for CookieSessionApplication<A> {
    type Config = A::Config;

    fn config() -> openrust::config::ConfigManifest {
        A::config()
    }
    fn default_providers() -> openrust::support::DefaultProviders {
        // Cookie 场景显式替换 Session，不让默认项的同类型去重吞掉替换。
        A::default_providers().except([openrust::foundation::ProviderId::of::<SessionServiceProvider>()])
    }
    fn package_providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        A::package_providers(config)
    }
    fn additional_providers() -> Vec<Box<dyn ServiceProvider>> {
        A::additional_providers()
    }
    fn with_bootstrap_providers() -> bool {
        A::with_bootstrap_providers()
    }
    fn config_namespace() -> &'static str {
        A::config_namespace()
    }
    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        let cookie: Box<dyn ServiceProvider> = Box::new(
            SessionServiceProvider::new().with_cookie_config(SessionConfig {
                lottery: [1, 1],
                driver: Some("cookie".into()),
                cookie: Some("contract_cookie_session".into()),
                secure: Some(false),
                ..Default::default()
            }),
        );
        // 替换原位置，保留 Auth 等 Provider 对 Session 先注册的依赖顺序。
        if let Some(index) = providers.iter().position(|provider| {
            provider.id() == openrust::foundation::ProviderId::of::<SessionServiceProvider>()
        }) {
            providers[index] = cookie;
        } else {
            providers.push(cookie);
        }
        providers
    }
    fn configure_providers(config: &Self::Config, builder: &mut openrust::foundation::ProviderBuilder) {
        A::configure_providers(config, builder);
    }
}

#[allow(clippy::too_many_lines)] // 生成应用的正式 Provider、Cookie 往返和关闭必须留在同一生命周期。
async fn verify<A: ApplicationDefinition, const EXISTING: bool>(source: Figment) -> openrust::Result<()> {
    let mut app = TestApp::<SessionApplication<A, EXISTING>>::builder(source)
        .build()
        .await?;
    let outcome: openrust::Result<()> = async {
        let first = app
            .request_with_limits(request("set", None)?, BODY_LIMIT, REQUEST_TIMEOUT)
            .await?;
        let name = first.json::<Value>()?["data"]["cookie_name"]
            .as_str()
            .ok_or_else(mismatch)?
            .to_owned();
        ensure(!name.is_empty() && name.len() <= 64 * 1024)?;
        check_response(
            &first,
            expected(
                &name,
                true,
                Some("next"),
                Some("current"),
                Some("computed"),
                Some(&["first"]),
                Some(1),
                None,
            ),
        )?;
        let first_cookie = cookie_pair(&first, &name)?;
        let second = app
            .request_with_limits(
                request("inspect", Some(&first_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &second,
            expected(
                &name,
                true,
                Some("next"),
                None,
                Some("computed"),
                Some(&["first"]),
                Some(1),
                None,
            ),
        )?;
        // 每次都从真实响应取得下一次 Cookie，不假定保护后的字节保持不变。
        let second_cookie = cookie_pair(&second, &name)?;
        let third = app
            .request_with_limits(
                request("inspect", Some(&second_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &third,
            expected(
                &name,
                true,
                None,
                None,
                Some("computed"),
                Some(&["first"]),
                Some(1),
                None,
            ),
        )?;
        let third_cookie = cookie_pair(&third, &name)?;
        let advanced = app
            .request_with_limits(
                request("advance", Some(&third_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &advanced,
            expected(
                &name,
                true,
                None,
                None,
                Some("computed"),
                Some(&["first", "second"]),
                Some(0),
                None,
            ),
        )?;
        let advanced_cookie = cookie_pair(&advanced, &name)?;
        let removed = app
            .request_with_limits(
                request("remove", Some(&advanced_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &removed,
            expected(
                &name,
                true,
                None,
                None,
                None,
                Some(&["first", "second"]),
                Some(0),
                Some("computed"),
            ),
        )?;
        let removed_cookie = cookie_pair(&removed, &name)?;
        let after_remove = app
            .request_with_limits(
                request("inspect", Some(&removed_cookie))?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(
            &after_remove,
            expected(
                &name,
                true,
                None,
                None,
                None,
                Some(&["first", "second"]),
                Some(0),
                None,
            ),
        )?;
        let isolated = app
            .request_with_limits(request("inspect", None)?, BODY_LIMIT, REQUEST_TIMEOUT)
            .await?;
        check_response(
            &isolated,
            expected(&name, false, None, None, None, None, None, None),
        )?;
        verify_request_driver(&app, &name).await?;
        verify_previous(&app, &name).await?;
        verify_old_input(&app, &name).await?;
        verify_object_codec(&app).await?;
        Ok(())
    }
    .await;
    let shutdown = app
        .shutdown(openrust::tokio::time::Instant::now() + Duration::from_secs(5))
        .await;
    outcome?;
    shutdown?;
    Ok(())
}

struct GeneratedObject;

impl DataObject for GeneratedObject {
    fn as_any(&self) -> &dyn Any {
        self
    }

    fn json_projection(&self) -> Option<Value> {
        Some(json!("generated"))
    }
}

async fn verify_object_codec<A: ApplicationDefinition, const EXISTING: bool>(
    app: &TestApp<SessionApplication<A, EXISTING>>,
) -> openrust::Result<()> {
    let store = app
        .app()?
        .state()
        .resolve::<SessionStoreHandle>()
        .await?
        .store();
    let jar = CookieJar::new(CookieFactory::default());
    let session = Session::new(None, store.clone(), None)?;
    session
        .set_request_on_handler(SessionRequestContext::new(json!({}), jar.clone())?)
        .await?;
    session.start().await?;
    let object = DataValue::object(GeneratedObject);
    session.put("contract.object", object.clone())?;
    ensure(
        session
            .get("contract.object")?
            .is_some_and(|value| value.same_object(&object)),
    )?;
    let error = session.save().await.err().ok_or_else(mismatch)?;
    ensure(error.code() == "data_object_not_serializable")?;
    ensure(
        session
            .get("contract.object")?
            .is_some_and(|value| value.same_object(&object)),
    )?;
    let id = session.id()?;
    if store.guarantees() == openrust::session::SessionStoreGuarantees::ClientSideSnapshot {
        ensure(!jar.has_queued(id.as_str(), None)?)?;
    }
    ensure(
        session
            .handler()?
            .load(
                &id,
                openrust::session::DEFAULT_MAX_BYTES,
                session.expiry_date()?,
            )
            .await?
            .is_none(),
    )?;
    session.set_object_encoding(ObjectEncoding::JsonProjection)?;
    session.save().await?;
    let mut cookies = json!({});
    if store.guarantees() == openrust::session::SessionStoreGuarantees::ClientSideSnapshot {
        let value = jar.queued(id.as_str(), None)?.ok_or_else(mismatch)?;
        cookies[id.as_str()] = json!(value.value());
    }
    let reloaded = Session::new(Some(id), store, None)?;
    reloaded
        .set_request_on_handler(SessionRequestContext::new(
            cookies,
            CookieJar::new(CookieFactory::default()),
        )?)
        .await?;
    reloaded.start().await?;
    ensure(reloaded.get_json("contract.object")? == Some(json!("generated")))?;
    Ok(())
}

#[allow(clippy::too_many_arguments)] // 逐项列出固定响应字段，避免测试遗漏原有 Session 与新增 Store 值。
fn expected(
    name: &str,
    persisted: bool,
    notice: Option<&str>,
    now: Option<&str>,
    memo: Option<&str>,
    list: Option<&[&str]>,
    count: Option<i64>,
    removed: Option<&str>,
) -> Value {
    let mut value = json!({"cookie_name":name, "same_handle":true, "shared_value":persisted,
        "stored_null":persisted, "preference":persisted.then_some("preserved"), "notice":notice, "now":now,
        "memo":memo,"list":list,"count":count});
    if let Some(removed) = removed {
        value["removed"] = json!(removed);
    }
    value
}
async fn previous_exchange<A: ApplicationDefinition, const EXISTING: bool>(
    app: &TestApp<SessionApplication<A, EXISTING>>,
    action: &str,
    name: &str,
    cookies: &mut Vec<(String, String)>,
    attempting: bool,
) -> openrust::Result<TestResponse> {
    let path = format!("{PREFIX}/previous/{action}");
    let mut wire = if action == "read" {
        Request::post(path)
    } else {
        Request::get(path)
    };
    wire = wire.header("host", "localhost");
    if !cookies.is_empty() {
        wire = wire.header(
            COOKIE,
            cookies
                .iter()
                .map(|(_, pair)| pair.as_str())
                .collect::<Vec<_>>()
                .join("; "),
        );
    }
    if attempting {
        wire = wire.header("precognition", "true");
    }
    let response = app
        .request_with_limits(
            wire.body(Body::empty())
                .map_err(openrust::Error::internal)?,
            BODY_LIMIT,
            REQUEST_TIMEOUT,
        )
        .await?;
    // confirmed 不执行 Cookie driver.save；未重发的数据 Cookie 仍须按浏览器语义保留。
    merge_probe_cookies(&response, name, cookies)?;
    Ok(response)
}

async fn verify_previous<A: ApplicationDefinition, const EXISTING: bool>(
    app: &TestApp<SessionApplication<A, EXISTING>>,
    name: &str,
) -> openrust::Result<()> {
    let named_url = format!("http://localhost{PREFIX}/previous/named");
    let anonymous_url = format!("http://localhost{PREFIX}/previous/anonymous");
    let mut cookies = Vec::new();
    for (action, url, route, calls, attempting) in [
        ("named", None, None, 1, false),
        (
            "anonymous",
            Some(named_url.as_str()),
            Some("contract.session.previous.named"),
            2,
            false,
        ),
        ("read", Some(anonymous_url.as_str()), None, 2, false),
        ("named", Some(anonymous_url.as_str()), None, 3, true),
    ] {
        let response = previous_exchange(app, action, name, &mut cookies, attempting).await?;
        check_response(
            &response,
            json!({"url":url,"route":route,"route_exists":url.is_some(),
            "attempting":attempting,"confirmed":false,"business_calls":calls}),
        )?;
    }
    let confirmed = previous_exchange(app, "preview", name, &mut cookies, true).await?;
    confirmed.assert_status(StatusCode::NO_CONTENT)?;
    ensure(confirmed.body().is_empty())?;
    for header in ["precognition", "precognition-success"] {
        ensure(
            confirmed
                .headers()
                .get(header)
                .and_then(|value| value.to_str().ok())
                == Some("true"),
        )?;
    }
    let after = previous_exchange(app, "read", name, &mut cookies, false).await?;
    // 此计数位于 Provider 的独立 AtomicUsize，不会被 skip-save 掩盖业务已执行。
    check_response(
        &after,
        json!({"url":named_url,"route":"contract.session.previous.named","route_exists":true,
        "attempting":false,"confirmed":false,"business_calls":3}),
    )?;
    Ok(())
}

fn request(action: &str, cookies: Option<&str>) -> openrust::Result<Request<Body>> {
    let mut request = Request::get(format!("{PREFIX}/{action}")).header("host", "localhost");
    if let Some(cookies) = cookies {
        request = request.header(COOKIE, cookies);
    }
    request
        .body(Body::empty())
        .map_err(openrust::Error::internal)
}
async fn verify_old_input<A: ApplicationDefinition>(app: &TestApp<A>, name: &str) -> openrust::Result<()> {
    let payload = json!({"name":"Generated","password":"secret"});
    let sent = old_input_post(app, "old-input", &payload, None, false).await?;
    check_response(
        &sent,
        json!({"all":{"name":"Generated"},"name":"Generated", "missing":"fallback",
            "business_calls":1}),
    )?;
    let cookie = cookie_pair(&sent, name)?;
    let confirmed = old_input_post(
        app,
        "old-input/preview",
        &json!({"name":"Preview","password":"secret"}),
        Some(&cookie),
        true,
    )
    .await?;
    confirmed.assert_status(StatusCode::NO_CONTENT)?;
    ensure(confirmed.body().is_empty())?;
    for header in ["precognition", "precognition-success"] {
        ensure(
            confirmed
                .headers()
                .get(header)
                .and_then(|value| value.to_str().ok())
                == Some("true"),
        )?;
    }
    // 已确认预检不自动保存 Session；旧 Cookie 仍代表已持久的旧输入。
    let loaded = app
        .request_with_limits(
            request("old-input", Some(&cookie))?,
            BODY_LIMIT,
            REQUEST_TIMEOUT,
        )
        .await?;
    check_response(
        &loaded,
        json!({"all":{"name":"Generated"},"name":"Generated", "missing":"fallback",
            "business_calls":1}),
    )?;
    let cookie = cookie_pair(&loaded, name)?;
    let attempted = old_input_post(
        app,
        "old-input",
        &json!({"name":"Attempted"}),
        Some(&cookie),
        true,
    )
    .await?;
    check_response(
        &attempted,
        json!({"all":{"name":"Attempted"},"name":"Attempted",
        "missing":"fallback","business_calls":2}),
    )?;
    ensure(attempted.headers().get("precognition-success").is_none())?;
    let cookie = cookie_pair(&attempted, name)?;
    let next = app
        .request_with_limits(
            request("old-input", Some(&cookie))?,
            BODY_LIMIT,
            REQUEST_TIMEOUT,
        )
        .await?;
    check_response(
        &next,
        json!({"all":{"name":"Attempted"},"name":"Attempted",
        "missing":"fallback","business_calls":2}),
    )?;
    let cookie = cookie_pair(&next, name)?;
    let aged = app
        .request_with_limits(
            request("old-input", Some(&cookie))?,
            BODY_LIMIT,
            REQUEST_TIMEOUT,
        )
        .await?;
    check_response(
        &aged,
        json!({"all":[],"name":null,"missing":"fallback","business_calls":2}),
    )?;
    let isolated = app
        .request_with_limits(request("old-input", None)?, BODY_LIMIT, REQUEST_TIMEOUT)
        .await?;
    check_response(
        &isolated,
        json!({"all":[],"name":null,"missing":"fallback","business_calls":2}),
    )?;
    let default_flash = old_input_post(app, "old-input/default", &payload, None, false).await?;
    check_response(
        &default_flash,
        json!({"all":{"name":"Generated","password":"secret"},
            "name":"Generated","missing":"fallback","business_calls":3}),
    )
}
async fn old_input_post<A: ApplicationDefinition>(
    app: &TestApp<A>,
    action: &str,
    payload: &Value,
    cookie: Option<&str>,
    attempting: bool,
) -> openrust::Result<TestResponse> {
    let mut wire = Request::post(format!("{PREFIX}/{action}"))
        .header("host", "localhost")
        .header("content-type", "application/json");
    if let Some(cookie) = cookie {
        wire = wire.header(COOKIE, cookie);
    }
    if attempting {
        wire = wire.header("precognition", "true");
    }
    app.request_with_limits(
        wire.body(Body::from(
            serde_json::to_vec(payload).map_err(openrust::Error::internal)?,
        ))
        .map_err(openrust::Error::internal)?,
        BODY_LIMIT,
        REQUEST_TIMEOUT,
    )
    .await
}
fn check_response(response: &TestResponse, data: Value) -> openrust::Result<()> {
    response
        .assert_status(StatusCode::OK)?
        .assert_json(&json!({"success":true,"code":"ok","message":"ok","data":data}))?;
    Ok(())
}
fn cookie_pair(response: &TestResponse, name: &str) -> openrust::Result<String> {
    let mut selected = None;
    let mut data = Vec::new();
    for value in response.headers().get_all(SET_COOKIE) {
        let text = value.to_str().map_err(|_| mismatch())?;
        let pair = text.split(';').next().ok_or_else(mismatch)?;
        let (key, value) = pair.split_once('=').ok_or_else(mismatch)?;
        if key == name {
            ensure(selected.is_none() && !value.is_empty())?;
            selected = Some(pair.to_owned());
        } else if SessionId::parse(key).is_ok() && !value.is_empty() {
            data.push(pair.to_owned());
        }
    }
    let mut pairs = vec![selected.ok_or_else(mismatch)?];
    pairs.extend(data);
    Ok(pairs.join("; "))
}

fn ensure(condition: bool) -> openrust::Result<()> {
    if condition { Ok(()) } else { Err(mismatch()) }
}
fn mismatch() -> openrust::Error {
    openrust::Error::custom(
        "test_session_contract_mismatch",
        "生成应用 Session 契约不匹配",
    )
}

const PROBE: &str = "contract_session_probe";
const REPLY: &str = "contract_session_reply";
struct ContractRequestDriver {
    backend: Arc<dyn SessionStore>,
    context: Option<SessionRequestContext>,
}
impl SessionStore for ContractRequestDriver {
    fn semantics(&self) -> openrust::session::SessionStoreSemantics {
        self.backend.semantics()
    }
    fn for_session(&self) -> openrust::Result<Option<Arc<dyn SessionStore>>> {
        let backend = self
            .backend
            .for_session()?
            .unwrap_or_else(|| self.backend.clone());
        Ok(Some(Arc::new(Self {
            backend,
            context: self.context.clone(),
        })))
    }
    fn activity_lifetime_seconds(&self) -> Option<i64> {
        self.backend.activity_lifetime_seconds()
    }
    fn reset_exists(&self) -> openrust::Result<()> {
        self.backend.reset_exists()
    }
    fn set_database_user_id(
        &self,
        user_id: openrust::database::sea_orm::Value,
    ) -> openrust::Result<bool> {
        self.backend.set_database_user_id(user_id)
    }
    fn accepts_request(&self) -> bool {
        // 当前装饰器本身需要请求Cookie，也转交底层native的可选请求metadata。
        self.needs_request() || self.backend.accepts_request()
    }
    fn gc(&self, lifetime_seconds: i64) -> BoxFuture<'_, openrust::Result<u64>> {
        Box::pin(async move {
            let deleted = self.backend.gc(lifetime_seconds).await?;
            if let Some(context) = &self.context {
                let jar = context.cookie_jar();
                jar.queue(jar.factory().make(
                    "contract_session_gc",
                    format!("{lifetime_seconds}:{deleted}"),
                    0,
                    CookieOptions::default(),
                )?)?;
            }
            Ok(deleted)
        })
    }

    fn supports_session_authentication(&self, cookie_name: &str) -> bool {
        self.backend.supports_session_authentication(cookie_name)
    }
    fn guarantees(&self) -> openrust::session::SessionStoreGuarantees {
        self.backend.guarantees()
    }
    fn needs_request(&self) -> bool {
        true
    }
    fn bind_request(
        &self,
        context: SessionRequestContext,
    ) -> openrust::Result<Option<Arc<dyn SessionStore>>> {
        let backend = if self.backend.accepts_request() {
            self.backend
                .bind_request(context.clone())?
                .ok_or_else(mismatch)?
        } else {
            self.backend
                .for_session()?
                .unwrap_or_else(|| self.backend.clone())
        };
        Ok(Some(Arc::new(Self {
            backend,
            context: Some(context),
        })))
    }
    fn load<'a>(
        &'a self,
        id: &'a SessionId,
        max: usize,
        expiry: OffsetDateTime,
    ) -> BoxFuture<'a, openrust::Result<Option<SessionRecord>>> {
        Box::pin(async move {
            let value = self.backend.load(id, max, expiry).await?;
            self.acknowledge()?;
            Ok(value)
        })
    }
    fn write<'a>(
        &'a self,
        record: &'a SessionRecord,
        mode: SessionWriteMode,
        max: usize,
    ) -> BoxFuture<'a, openrust::Result<SessionWriteOutcome>> {
        Box::pin(async move {
            let value = self.backend.write(record, mode, max).await?;
            self.acknowledge()?;
            Ok(value)
        })
    }
    fn delete<'a>(&'a self, id: &'a SessionId) -> BoxFuture<'a, openrust::Result<()>> {
        self.backend.delete(id)
    }
}
impl ContractRequestDriver {
    fn acknowledge(&self) -> openrust::Result<()> {
        let Some(context) = &self.context else {
            return Ok(());
        };
        let value = match context.cookie(PROBE) {
            Some(Value::String(value)) if matches!(value.as_str(), "one" | "two") => value,
            _ => return Ok(()),
        };
        let jar = context.cookie_jar();
        jar.queue(
            jar.factory()
                .make(REPLY, value, 0, CookieOptions::default())?,
        )
    }
}
async fn seed_one(session: Session, jar: CookieJar) -> openrust::Result<Json<Value>> {
    seed(&session, &jar, "one")
}
async fn seed_two(session: Session, jar: CookieJar) -> openrust::Result<Json<Value>> {
    seed(&session, &jar, "two")
}
fn seed(session: &Session, jar: &CookieJar, value: &str) -> openrust::Result<Json<Value>> {
    ensure(session.handler_needs_request()?)?;
    jar.queue(
        jar.factory()
            .make(PROBE, value, 0, CookieOptions::default())?,
    )?;
    Ok(Json(json!({"seeded":true})))
}
async fn probe(session: Session, info: RequestInfo) -> openrust::Result<Json<Value>> {
    Ok(Json(
        json!({"needs_request":session.handler_needs_request()?, "reply":info.cookie(REPLY),"gc":gc_receipt_valid(info.cookie("contract_session_gc"))}),
    ))
}
fn gc_receipt_valid(value: Option<Value>) -> bool {
    value
        .and_then(|value| value.as_str().map(str::to_owned))
        .filter(|value| value.len() <= 42)
        .is_some_and(|value| {
            value.split_once(':').is_some_and(|(seconds, deleted)| {
                seconds == "7200" && deleted.parse::<u64>().is_ok()
            })
        })
}
async fn verify_request_driver<A: ApplicationDefinition, const EXISTING: bool>(
    app: &TestApp<SessionApplication<A, EXISTING>>,
    name: &str,
) -> openrust::Result<()> {
    let mut first = Vec::<(String, String)>::new();
    let mut second = Vec::<(String, String)>::new();
    for (cookies, action) in [(&mut first, "seed-one"), (&mut second, "seed-two")] {
        let response = app
            .request_with_limits(request(action, None)?, BODY_LIMIT, REQUEST_TIMEOUT)
            .await?;
        check_response(&response, json!({"seeded":true}))?;
        merge_probe_cookies(&response, name, cookies)?;
    }
    for round in 0..2 {
        for (cookies, value) in [(&mut first, "one"), (&mut second, "two")] {
            let incoming = cookies
                .iter()
                .map(|(_, pair)| pair.as_str())
                .collect::<Vec<_>>()
                .join("; ");
            let response = app
                .request_with_limits(
                    request("probe", Some(&incoming))?,
                    BODY_LIMIT,
                    REQUEST_TIMEOUT,
                )
                .await?;
            check_response(
                &response,
                json!({"needs_request":true,"reply":(round == 1).then_some(value),"gc":true}),
            )?;
            merge_probe_cookies(&response, name, cookies)?;
        }
    }
    Ok(())
}
fn merge_probe_cookies(
    response: &TestResponse,
    name: &str,
    cookies: &mut Vec<(String, String)>,
) -> openrust::Result<()> {
    for header in response.headers().get_all(SET_COOKIE) {
        let pair = header
            .to_str()
            .map_err(|_| mismatch())?
            .split(';')
            .next()
            .ok_or_else(mismatch)?;
        let (key, _) = pair.split_once('=').ok_or_else(mismatch)?;
        if ![name, PROBE, REPLY, "contract_session_gc"].contains(&key)
            && SessionId::parse(key).is_err()
        {
            continue;
        }
        if let Some(existing) = cookies.iter_mut().find(|(name, _)| name == key) {
            existing.1 = pair.to_owned();
        } else {
            cookies.push((key.to_owned(), pair.to_owned()));
        }
    }
    Ok(())
}

// 只追加路由，不注册或覆盖 Session，防止 fixture 掩盖生成宿主漏装 Provider。
struct OriginalHostRoutes;
impl ServiceProvider for OriginalHostRoutes {
    fn boot<'a>(&'a self, app: &'a mut BootContext<'_>) -> BoxFuture<'a, openrust::Result<()>> {
        Box::pin(async move {
            app.routes(|routes: Router| {
                routes.group(
                    RouteGroup::new()
                        .middleware_alias("cookies")
                        .middleware_alias("session"),
                    |routes| {
                        routes
                            .get("/__original-session/write", original_write)
                            .get("/__original-session/read", original_read)
                    },
                )
            })?;
            Ok(())
        })
    }
}
async fn original_write(session: Session) -> openrust::Result<Json<Value>> {
    session.put_typed("contract.original_host", "persisted")?;
    original_read(session).await
}
async fn original_read(session: Session) -> openrust::Result<Json<Value>> {
    Ok(Json(
        json!({"value":session.get_json("contract.original_host")?,"snapshot":session.handler()?.guarantees()==openrust::session::SessionStoreGuarantees::ClientSideSnapshot}),
    ))
}
struct OriginalHost<A>(std::marker::PhantomData<fn() -> A>);
impl<A: ApplicationDefinition> ApplicationDefinition for OriginalHost<A> {
    type Config = A::Config;

    fn config() -> openrust::config::ConfigManifest {
        A::config()
    }
    fn default_providers() -> openrust::support::DefaultProviders {
        A::default_providers()
    }
    fn package_providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        A::package_providers(config)
    }
    fn additional_providers() -> Vec<Box<dyn ServiceProvider>> {
        A::additional_providers()
    }
    fn with_bootstrap_providers() -> bool {
        A::with_bootstrap_providers()
    }
    fn config_namespace() -> &'static str {
        A::config_namespace()
    }
    fn providers(config: &Self::Config) -> Vec<Box<dyn ServiceProvider>> {
        let mut providers = A::providers(config);
        providers.push(Box::new(OriginalHostRoutes));
        providers
    }
    fn configure_providers(config: &Self::Config, builder: &mut openrust::foundation::ProviderBuilder) {
        A::configure_providers(config, builder);
    }
}
pub async fn assert_original_host_cookie_session<A: ApplicationDefinition>(
    source: Figment,
) -> Result<(), Box<dyn std::error::Error>> {
    let source = source.merge(figment::providers::Serialized::defaults(
        json!({"session":{"driver":"cookie","cookie":"original_host_session","secure":false,"lottery":[1,1]}}),
    ));
    let configuration: A::Config = source.extract().map_err(openrust::Error::internal)?;
    let mut app = TestApp::<OriginalHost<A>>::builder(source).build().await?;
    let outcome: openrust::Result<()> = async {
        let mut providers = A::default_providers().resolve(&app.app()?.config_repository())?;
        providers.extend(A::package_providers(&configuration));
        providers.extend(A::additional_providers());
        if A::with_bootstrap_providers() {
            providers.extend(A::providers(&configuration));
        }
        assert_eq!(
            providers
                .iter()
                .filter(|provider| provider.id()
                    == openrust::foundation::ProviderId::of::<SessionServiceProvider>())
                .count(),
            1,
        );
        let response = app
            .request_with_limits(
                Request::get("/__original-session/write")
                    .header("host", "localhost")
                    .body(Body::empty())
                    .map_err(openrust::Error::internal)?,
                BODY_LIMIT,
                REQUEST_TIMEOUT,
            )
            .await?;
        check_response(&response, json!({"value":"persisted","snapshot":true}))?;
        let pairs = cookie_pair(&response, "original_host_session")?;
        ensure(pairs.split("; ").count() == 2)?;
        for _ in 0..2 {
            let response = app
                .request_with_limits(
                    Request::get("/__original-session/read")
                        .header("host", "localhost")
                        .header(COOKIE, &pairs)
                        .body(Body::empty())
                        .map_err(openrust::Error::internal)?,
                    BODY_LIMIT,
                    REQUEST_TIMEOUT,
                )
                .await?;
            check_response(&response, json!({"value":"persisted","snapshot":true}))?;
        }
        Ok(())
    }
    .await;
    let stopped = app
        .shutdown(tokio::time::Instant::now() + REQUEST_TIMEOUT)
        .await;
    outcome?;
    stopped?;
    Ok(())
}

