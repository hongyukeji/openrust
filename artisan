#!/bin/sh
set -eu

CDPATH='' cd -P "$(dirname -- "$0")"
export OPENRUST_ARTISAN=1

run_dev() {
    cli_manifest='tools/cli/Cargo.toml'
    if [ -f "$cli_manifest" ]; then
        exec cargo run --quiet --manifest-path "$cli_manifest" --bin openrust -- dev --watch "$@"
    fi
    if command -v openrust >/dev/null 2>&1; then
        exec openrust dev --watch "$@"
    fi
    printf '%s\n' 'artisan: 开发重载需要本地 OpenRust CLI 源码或 PATH 中的 openrust' >&2
    exit 127
}

if [ -f Cargo.toml ] && [ -f src/main.rs ]; then
    if ! command -v cargo >/dev/null 2>&1; then
        printf '%s\n' 'artisan: 源码应用需要 Cargo' >&2
        exit 127
    fi
    case "${1-}" in
        dev)
            shift
            run_dev "$@"
            ;;
        --env=*)
            if [ "${2-}" = dev ]; then
                environment=$1
                shift 2
                run_dev "$environment" "$@"
            fi
            ;;
        --env)
            if [ "${3-}" = dev ]; then
                environment=$2
                shift 3
                run_dev --env "$environment" "$@"
            fi
            ;;
    esac
    exec cargo run --quiet -- "$@"
fi

if [ ! -f ./app ]; then
    printf '%s\n' 'artisan: 部署目录缺少应用二进制 ./app' >&2
    exit 127
fi
if [ ! -x ./app ]; then
    printf '%s\n' 'artisan: 应用二进制 ./app 不可执行' >&2
    exit 126
fi
exec ./app "$@"
