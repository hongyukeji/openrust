#!/bin/sh
set -eu

CDPATH='' cd -P "$(dirname -- "$0")"
export OPENRUST_ARTISAN=1

run_cli() {
    cli_manifest='tools/cli/Cargo.toml'
    if [ -f "$cli_manifest" ]; then
        case "$1" in
            package:discover|package:list)
                command=$1
                shift
                application=$(pwd -P)
                cli_directory=$(CDPATH='' cd -P "$(dirname -- "$cli_manifest")" && pwd -P)
                CDPATH='' cd -P "$cli_directory/../.."
                cli_manifest=tools/cli/Cargo.toml
                set -- --locked -- "$command" --project-dir "$application" "$@"
                ;;
            *) set -- -- "$@" ;;
        esac
        exec cargo run --quiet --manifest-path "$cli_manifest" --bin openrust "$@"
    fi
    if command -v openrust >/dev/null 2>&1; then
        exec openrust "$@"
    fi
    printf 'artisan: %s 需要本地 OpenRust CLI 源码或 PATH 中的 openrust\n' "$1" >&2
    exit 127
}

if [ -f Cargo.toml ] && [ -f src/main.rs ]; then
    if ! command -v cargo >/dev/null 2>&1; then
        printf '%s\n' 'artisan: 源码应用需要 Cargo' >&2
        exit 127
    fi
    case "${1-}" in
        dev)
            shift
            run_cli dev --watch "$@"
            ;;
        package:discover|package:list)
            run_cli "$@"
            ;;
        --env=*)
            if [ "${2-}" = dev ]; then
                environment=$1
                shift 2
                run_cli dev --watch "$environment" "$@"
            fi
            ;;
        --env)
            if [ "${3-}" = dev ]; then
                environment=$2
                shift 3
                run_cli dev --watch --env "$environment" "$@"
            fi
            ;;
    esac
    exec cargo run --quiet -- "$@"
fi

if [ ! -f ./app ]; then
    printf '%s\n' 'artisan: 部署目录缺少应用二进制 ./app' >&2
    exit 127
fi
if [ ! -x ./app ]; then
    printf '%s\n' 'artisan: 应用二进制 ./app 不可执行' >&2
    exit 126
fi
exec ./app "$@"
